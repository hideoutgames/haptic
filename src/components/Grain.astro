---
/**
 * Film-grain layers. The noise tiles are generated once per page load by the
 * inline script in Base.astro (no image asset), so this is just two styled
 * divs. Place inside a positioned parent; set `opacity` to override the
 * default strength.
 */
interface Props {
  opacity?: number;
  class?: string;
}

const { opacity, class: className } = Astro.props;
const style = opacity !== undefined ? `--grain-opacity: ${opacity}` : undefined;
---

<div class:list={['grain-layer grain-layer--light', className]} style={style} aria-hidden="true"></div>
<div class:list={['grain-layer grain-layer--dark', className]} style={style} aria-hidden="true"></div>
