---
/**
 * Site header: the H logo (fixed, top centre, always visible) is the menu
 * button; the popover lists the pages. A soft black fade under the H keeps it
 * legible over whatever scrolls beneath. Behaviour lives in header/header.ts.
 */
import HeaderLogo from './header/HeaderLogo.astro';
import MenuPanel from './header/MenuPanel.astro';

/** "Haptic Engine" column: site pages, without the deploy base. */
const pages = [
  { label: 'Home', href: '/' },
  { label: 'Download', href: '/download' },
  { label: 'Support', href: '/support' },
  { label: 'About', href: '/about' },
];

/** "Learning Center" column. The docs are not online yet: a plain fragment for now. */
const learning = [{ label: 'Documentation', href: '#docs' }];

// Astro.url.pathname includes the deploy base; the page list above does not.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { pathname } = Astro.url;
const currentPath = (pathname.startsWith(base) ? pathname.slice(base.length) : pathname).replace(/\/+$/, '') || '/';
const menuId = 'site-menu';
---

<header class="site-header" data-site-header>
  <button
    class="menu-button"
    type="button"
    aria-expanded="false"
    aria-controls={menuId}
    aria-label="Menu"
    data-menu-button
  >
    <HeaderLogo />
  </button>

  <MenuPanel id={menuId} {pages} {learning} {currentPath} />
</header>

<noscript>
  <style is:inline>
    .site-header {
      --fade-from: -100px;
    }
  </style>
</noscript>

<script>
  import '../components/header/header.ts';
</script>

<style>
  .site-header {
    /* Header scale: follows the page's --u but never shrinks below 0.9 so the
       menu text stays readable on small laptops/tablets; fixed 1px on phones. */
    --m: max(var(--u), 0.9px);
    --safe-top: env(safe-area-inset-top, 0px);
    /* Fade under the H: a wide, shallow ellipse centred just below the H's
       middle. It reads as a soft shade hanging from the top edge, ends above
       the showcase heading and only grazes the devices beside it. That heading
       is never less than 15svh down (DeviceShowcase.astro: 0.66svh - 401 *
       0.00127svh once the viewport is short), and its letters start about 4px
       below its box, so on short screens (landscape phones, small laptop
       windows) the ellipse gets shallower, and narrower in proportion. */
    --fade-cy: calc(var(--safe-top) + 34 * var(--m));
    --fade-y: clamp(18px, calc(15svh + 4px - 34 * var(--m)), calc(72 * var(--m)));
    --fade-x: min(calc(400 * var(--m)), calc(var(--fade-y) * 5.5));
    --fade-feather: calc(24 * var(--m));
    --fade-strength: 0.7;
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    height: calc(var(--safe-top) + 56 * var(--m));
    /* The bar spans the viewport but only the button and open menu take pointers. */
    pointer-events: none;
  }

  /*
   * The fade: black at full strength across the H and its fringes, then a
   * raised-cosine falloff (flat at both ends, so no edge or band shows) to
   * nothing. Behind it, a band as tall as the safe-area inset keeps a phone's
   * status bar readable too (zero height where there is no inset).
   *
   * It only covers what scrolls up below the hero's glow and lettering: the
   * mask starts at --fade-from, which header.ts keeps on the top edge of the
   * hero's editor window (feathered in just below it, so a frame of scroll
   * lag never shades the glow). Until header.ts runs the fade is held back;
   * without JS it is simply on (the <noscript> rule).
   */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: calc(var(--fade-cy) + var(--fade-y));
    background:
      linear-gradient(rgb(0 0 0 / 0.6), rgb(0 0 0 / 0.45) 60%, rgb(0 0 0 / 0)) top / 100%
        calc(var(--safe-top) * 1.4) no-repeat,
      radial-gradient(
        var(--fade-x) var(--fade-y) at 50% var(--fade-cy),
        rgb(0 0 0) 28%,
        rgb(0 0 0 / 0.976) 35.2%,
        rgb(0 0 0 / 0.905) 42.4%,
        rgb(0 0 0 / 0.794) 49.6%,
        rgb(0 0 0 / 0.655) 56.8%,
        rgb(0 0 0 / 0.5) 64%,
        rgb(0 0 0 / 0.345) 71.2%,
        rgb(0 0 0 / 0.206) 78.4%,
        rgb(0 0 0 / 0.095) 85.6%,
        rgb(0 0 0 / 0.024) 92.8%,
        rgb(0 0 0 / 0) 100%
      );
    -webkit-mask-image: linear-gradient(
      transparent var(--fade-from, 100%),
      #000 calc(var(--fade-from, 100%) + var(--fade-feather))
    );
    mask-image: linear-gradient(
      transparent var(--fade-from, 100%),
      #000 calc(var(--fade-from, 100%) + var(--fade-feather))
    );
    opacity: var(--fade-strength);
    pointer-events: none;
  }

  .menu-button {
    position: absolute;
    top: calc(var(--safe-top) + 8 * var(--m));
    left: 50%;
    width: calc(56 * var(--m));
    height: calc(48 * var(--m));
    margin-left: calc(-28 * var(--m));
    border-radius: calc(14 * var(--m));
    pointer-events: auto;
    -webkit-tap-highlight-color: transparent;
  }

  /* The mark tints slightly darker on hover/press to read as a button. */
  .menu-button :global(.logo) {
    transition: filter 0.18s ease;
  }

  @media (hover: hover) {
    .menu-button:hover :global(.logo) {
      filter: brightness(0.8);
    }
  }

  .menu-button:active :global(.logo) {
    filter: brightness(0.7);
  }

  /* Keyboard focus gets a soft white ring instead of the global amber outline.
     Focus returned to the button after a pointer-opened menu stays quiet. */
  .menu-button:focus-visible {
    outline: none;
    box-shadow: 0 0 0 1.5px rgb(255 255 255 / 0.55);
  }

  .menu-button[data-quiet-focus]:focus-visible {
    box-shadow: none;
  }

  @media (max-width: 820px) {
    .site-header {
      --m: 1px;
    }
  }

  /* Phones and tablets in portrait (the showcase's stacked layout, same query
     as DeviceShowcase.astro): across the whole width (fading toward the
     edges), and ending above the stacked showcase heading, which sits
     clamp(68px, 11svh, 92px) below the safe area. */
  @media (max-width: 820px) and (max-aspect-ratio: 1/1) {
    .site-header {
      --fade-x: 70vw;
      --fade-y: clamp(44px, calc(11svh - 26px), 66px);
    }
  }
</style>
