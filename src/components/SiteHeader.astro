---
/**
 * Site header: the H logo (fixed, top centre, always visible) is the menu
 * button; the popover lists the pages. A soft black fade under the H keeps it
 * legible over whatever scrolls beneath, and while the menu is open the rest
 * of the page is tinted a little darker. Behaviour lives in header/header.ts.
 */
import HeaderLogo from './header/HeaderLogo.astro';
import MenuPanel from './header/MenuPanel.astro';

/**
 * "Haptic Engine" column: site pages, without the deploy base. The footer-gap
 * clamp in MenuPanel.astro (`340.2 * --m`) assumes four links here: update it
 * when one is added or removed.
 */
const pages = [
  { label: 'Home', href: '/' },
  { label: 'Download', href: '/download' },
  { label: 'Support', href: '/support' },
  { label: 'About', href: '/about' },
];

/** "Learning Center" column. The docs are not online yet: a plain fragment for now. */
const learning = [{ label: 'Documentation', href: '#docs' }];

// Astro.url.pathname includes the deploy base; the page list above does not.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { pathname } = Astro.url;
const currentPath = (pathname.startsWith(base) ? pathname.slice(base.length) : pathname).replace(/\/+$/, '') || '/';
const menuId = 'site-menu';
---

<header class="site-header" data-site-header>
  <div class="page-tint" aria-hidden="true"></div>

  <button
    class="menu-button"
    type="button"
    aria-expanded="false"
    aria-controls={menuId}
    aria-label="Menu"
    data-menu-button
  >
    <HeaderLogo />
  </button>

  <MenuPanel id={menuId} {pages} {learning} {currentPath} />
</header>

<script>
  import '../components/header/header.ts';
</script>

<style>
  .site-header {
    /* Header scale: follows the page's --u but never shrinks below 0.9 so the
       menu text stays readable on small laptops/tablets; fixed 1px on phones. */
    --m: max(var(--u), 0.9px);
    --safe-top: env(safe-area-inset-top, 0px);
    /* Fade under the H: a shade across the whole width, solid from the top
       edge down past the H, then fading out to nothing --fade-y below the H's
       middle (--fade-cy). It ends above the showcase heading. That heading
       is never less than 15svh down (DeviceShowcase.astro: 66svh - 401 *
       0.127svh once the viewport is short), and its letters start about 4px
       below its box, so on short screens (landscape phones, small laptop
       windows) the fade gets shallower (at most 72 * --m). */
    --fade-cy: calc(var(--safe-top) + 34 * var(--m));
    --fade-y: clamp(18px, calc(15svh + 4px - 34 * var(--m)), calc(72 * var(--m)));
    /* At its core the fade takes white content (the HAPTIC lettering, the
       download buttons) down to about 40% grey, which still leaves the H's
       white more than 5:1 against it, without a heavy smudge on the hero's
       bright glow. */
    --fade-strength: 0.6;
    /* Black over the rest of the page while the menu is open: dimmed, but the
       page still reads clearly behind the panel. */
    --tint-strength: 0.35;
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    height: calc(var(--safe-top) + 56 * var(--m));
    /* The bar spans the viewport but only the button and open menu take pointers. */
    pointer-events: none;
  }

  /*
   * The fade: black at full strength from the top edge (a phone's status bar
   * included) down across the H and its fringes, then a raised-cosine falloff
   * (flat at both ends, so no edge or band shows) to nothing at the bottom.
   * It is fixed with the header, so it is always under the H, over every
   * section (the hero's lettering included) and at every scroll position.
   */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: calc(var(--fade-cy) + var(--fade-y));
    background: linear-gradient(
      rgb(0 0 0) calc(var(--fade-cy) + 0.28 * var(--fade-y)),
      rgb(0 0 0 / 0.976) calc(var(--fade-cy) + 0.352 * var(--fade-y)),
      rgb(0 0 0 / 0.905) calc(var(--fade-cy) + 0.424 * var(--fade-y)),
      rgb(0 0 0 / 0.794) calc(var(--fade-cy) + 0.496 * var(--fade-y)),
      rgb(0 0 0 / 0.655) calc(var(--fade-cy) + 0.568 * var(--fade-y)),
      rgb(0 0 0 / 0.5) calc(var(--fade-cy) + 0.64 * var(--fade-y)),
      rgb(0 0 0 / 0.345) calc(var(--fade-cy) + 0.712 * var(--fade-y)),
      rgb(0 0 0 / 0.206) calc(var(--fade-cy) + 0.784 * var(--fade-y)),
      rgb(0 0 0 / 0.095) calc(var(--fade-cy) + 0.856 * var(--fade-y)),
      rgb(0 0 0 / 0.024) calc(var(--fade-cy) + 0.928 * var(--fade-y)),
      rgb(0 0 0 / 0) calc(var(--fade-cy) + var(--fade-y))
    );
    opacity: var(--fade-strength);
    pointer-events: none;
  }

  /*
   * While the menu is open the page behind it is tinted a little darker. The
   * layer sits in the header (above the page, below the fade, the button and
   * the panel) and fades with the panel. It takes no pointers, so a click on
   * the page still lands there and closes the menu, and it changes nothing
   * about layout or scrolling. 100lvh: it still covers the page when a phone's
   * toolbars slide away during a scroll.
   */
  .page-tint {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    height: 100lvh;
    z-index: -2;
    background: rgb(0 0 0 / var(--tint-strength));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.18s ease,
      visibility 0s linear 0.18s;
  }

  [data-open] .page-tint {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.28s ease 0.05s,
      visibility 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .page-tint {
      transition-duration: 0.12s !important;
    }

    [data-open] .page-tint {
      transition-delay: 0s !important;
    }
  }

  .menu-button {
    position: absolute;
    top: calc(var(--safe-top) + 8 * var(--m));
    left: 50%;
    width: calc(56 * var(--m));
    height: calc(48 * var(--m));
    margin-left: calc(-28 * var(--m));
    border-radius: calc(14 * var(--m));
    pointer-events: auto;
    -webkit-tap-highlight-color: transparent;
  }

  /* The mark tints slightly darker on hover/press to read as a button. */
  .menu-button :global(.logo) {
    transition: filter 0.18s ease;
  }

  @media (hover: hover) {
    .menu-button:hover :global(.logo) {
      filter: brightness(0.8);
    }
  }

  .menu-button:active :global(.logo) {
    filter: brightness(0.7);
  }

  /* Keyboard focus gets a soft white ring instead of the global amber outline.
     Focus returned to the button after a pointer-opened menu stays quiet. */
  .menu-button:focus-visible {
    outline: none;
    box-shadow: 0 0 0 1.5px rgb(255 255 255 / 0.55);
  }

  .menu-button[data-quiet-focus]:focus-visible {
    box-shadow: none;
  }

  @media (max-width: 820px) {
    .site-header {
      --m: 1px;
    }
  }

  /* Phones and tablets in portrait (the showcase's stacked layout, same query
     as DeviceShowcase.astro and STACKED_QUERY): the fade ends where the
     stacked showcase heading's letters start. Its box sits clamp(68px, 11svh,
     92px) below the safe area; the fade ends 8-10px lower (34px + --fade-y),
     and at line-height 1.25 the letters start 4-8px below the box, so at most
     the last few px of the falloff reach their tops (about 1-3% black on
     common phones, up to 6% on very short ones). */
  @media (max-width: 820px) and (max-aspect-ratio: 1/1) {
    .site-header {
      --fade-y: clamp(44px, calc(11svh - 26px), 66px);
    }
  }
</style>
