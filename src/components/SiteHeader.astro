---
/**
 * Site header: the H logo (fixed, top centre, always visible) is the menu
 * button; the popover lists the pages. A faint dark scrim under it keeps the
 * logo legible over screenshots and devices. Behaviour lives in header/header.ts.
 */
import HeaderLogo from './header/HeaderLogo.astro';
import MenuPanel from './header/MenuPanel.astro';

const pages = [
  { label: 'Home', href: '/' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Download', href: '/download' },
  { label: 'Support', href: '/support' },
  { label: 'About', href: '/about' },
];

// Astro.url.pathname includes the deploy base; the page list above does not.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { pathname } = Astro.url;
const currentPath = (pathname.startsWith(base) ? pathname.slice(base.length) : pathname).replace(/\/+$/, '') || '/';
const menuId = 'site-menu';
---

<header class="site-header" data-site-header>
  <button
    class="menu-button"
    type="button"
    aria-expanded="false"
    aria-controls={menuId}
    aria-label="Menu"
    data-menu-button
  >
    <HeaderLogo />
  </button>

  <MenuPanel id={menuId} {pages} {currentPath} />
</header>

<script>
  import '../components/header/header.ts';
</script>

<style>
  .site-header {
    /* Header scale: follows the page's --u but never shrinks below 0.9 so the
       menu text stays readable on small laptops/tablets; fixed 1px on phones. */
    --m: max(var(--u), 0.9px);
    --safe-top: env(safe-area-inset-top, 0px);
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    height: calc(var(--safe-top) + 56 * var(--m));
    /* The bar spans the viewport but only the button and open menu take pointers. */
    pointer-events: none;
  }

  /* Scrim: eased dark fade under the logo, behind the button and the popover. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: calc(var(--safe-top) + 96 * var(--m));
    background: linear-gradient(
      rgb(8 7 6 / 0.55),
      rgb(8 7 6 / 0.42) 20%,
      rgb(8 7 6 / 0.26) 45%,
      rgb(8 7 6 / 0.11) 70%,
      rgb(8 7 6 / 0.03) 88%,
      rgb(8 7 6 / 0)
    );
    pointer-events: none;
  }

  .menu-button {
    position: absolute;
    top: calc(var(--safe-top) + 8 * var(--m));
    left: 50%;
    width: calc(56 * var(--m));
    height: calc(48 * var(--m));
    margin-left: calc(-28 * var(--m));
    border-radius: calc(14 * var(--m));
    pointer-events: auto;
    -webkit-tap-highlight-color: transparent;
  }

  @media (max-width: 820px) {
    .site-header {
      --m: 1px;
    }
  }
</style>
