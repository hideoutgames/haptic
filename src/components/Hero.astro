---
/**
 * Hero: night sky + CSS aurora glow, the HAPTIC wordmark with its lens-style
 * chromatic aberration, and the editor window. Everything except the sky photo
 * and the editor screenshot is drawn in CSS/SVG. Desktop values are mockup
 * pixels written as calc(N * var(--u)); ≤ 820px switches to a stacked layout.
 */
import { Picture } from 'astro:assets';
import Grain from './Grain.astro';
import nightSky from '../assets/bg/night-sky.jpg';
import editorTablet from '../assets/editor/editor-tablet.jpg';
import { glowBackground, GLOW_HEIGHT } from './hero/glow';
import { skyEdges, starTile } from './hero/sky';

const glow = glowBackground();
const skySide = `--sky-left: ${skyEdges.left}; --sky-right: ${skyEdges.right}; --sky-stars: ${starTile()}`;
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__sky" data-parallax="0.06">
      <div class="hero__sky-side" style={skySide}></div>
      <div class="hero__sky-photo">
        <Picture
          class="hero__sky-img"
          src={nightSky}
          alt=""
          widths={[800, 1280, 1920, 2560]}
          sizes="min(100vw, 1600px)"
          formats={['avif', 'webp']}
          quality={55}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    </div>
    <div
      class="hero__glow"
      data-parallax="0.12"
      style={`--glow: ${glow}; --glow-height: ${GLOW_HEIGHT}`}
    >
    </div>
  </div>

  <Grain />

  <div class="hero__content">
    <p class="presents">Hideout Presents</p>

    <h1 id="hero-title" class="title">
      <span class="title__ca title__ca--red" aria-hidden="true">HAPTIC</span>
      <span class="title__ca title__ca--amber" aria-hidden="true">HAPTIC</span>
      <span class="title__ink">HAPTIC</span>
    </h1>

    <p class="tagline">
      the{' '}
      <strong class="portable">
        <span class="portable__ca portable__ca--red" aria-hidden="true">portable</span>
        <span class="portable__ca portable__ca--amber" aria-hidden="true">portable</span>
        <span class="portable__ink">portable</span>
      </strong>{' '}
      game engine
    </p>

    <a class="scroll" href="#anywhere">
      <span class="scroll__label">Scroll to find out more</span>
      <svg class="scroll__chevron" viewBox="0 0 14 8" width="14" height="8" aria-hidden="true" focusable="false">
        <path d="M0.75 0.75 7 6.75 13.25 0.75" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>

  <div class="hero__window">
    <Picture
      class="hero__window-img"
      src={editorTablet}
      alt="The Haptic editor on iPad: a component tree on the left, a visual-scripting event graph in the middle and the inspector on the right."
      widths={[1024, 1536, 2048, 2360]}
      sizes="(max-width: 820px) calc(100vw - 48px), min(80vw, 1280px)"
      formats={['avif', 'webp']}
      quality={82}
      loading="eager"
      decoding="async"
    />
  </div>
</section>

<script>
  import { initHeroParallax } from './hero/hero-motion';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) initHeroParallax(hero);
</script>

<style>
  .hero {
    position: relative;
    height: calc(1263.5 * var(--u));
    color: var(--c-text);
  }

  /* ---- Background: sky photo + CSS glow (clipped; parallax moves inside) ---- */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: var(--z-bg);
    overflow: clip;
    background: var(--c-bg);
  }

  /* The photo fades up from pure black at the very top of the page. */
  .hero__bg::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: max(calc(80 * var(--u)), 56px);
    background: linear-gradient(#000, transparent);
  }

  /* Below the photo the page ramps from near-black to the navy that opens the
     showcase (its first backdrop band), so there is no seam where the two
     sections meet. It also covers whatever is left of the sky on viewports so
     wide that the photo is taller than the hero. */
  .hero__bg::before {
    content: '';
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    height: calc(263.5 * var(--u));
    background: linear-gradient(
      to bottom,
      transparent,
      rgb(1 14 26 / 0.18) 38%,
      rgb(1 14 26 / 0.35) 57%,
      rgb(1 14 26 / 0.53) 76%,
      rgb(1 14 26 / 0.85) 95%,
      #010e1a
    );
  }

  .hero__sky {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    will-change: transform;
    /* The photo's dark foreground melts into the page colour. */
    mask-image: linear-gradient(to bottom, #000 82%, transparent);
  }

  /* Sized like the glow (scales with --u, centred), so the photo keeps its
     scale relative to the content once --u stops growing at 1600px. */
  .hero__sky-photo {
    width: min(100%, calc(1280 * var(--u)));
    margin-inline: auto;
  }

  .hero__sky-img {
    width: 100%;
    height: auto;
    /* The grain lifts dark tones; pulling the photo's black level down keeps the
       sky as dark as the mockup's (gain 0.95, offset about -4.5 levels). */
    filter: brightness(0.92) contrast(1.035);
  }

  /* Wider than 1600px the photo no longer reaches the edges: its sides feather
     out over a gradient continuing its edge colours, with a procedural starfield
     (see hero/sky.ts). Hidden below, where the photo covers the full width. */
  @media (min-width: 1601px) {
    .hero__sky-photo {
      /* The photo fades over the gap it leaves, up to 240 mockup px. */
      --feather: clamp(0px, calc(50vw - 640 * var(--u)), calc(240 * var(--u)));
      mask-image: linear-gradient(
        to right,
        transparent,
        rgb(0 0 0 / 0.16) calc(var(--feather) * 0.25),
        rgb(0 0 0 / 0.5) calc(var(--feather) * 0.5),
        rgb(0 0 0 / 0.84) calc(var(--feather) * 0.75),
        #000 var(--feather),
        #000 calc(100% - var(--feather)),
        rgb(0 0 0 / 0.84) calc(100% - var(--feather) * 0.75),
        rgb(0 0 0 / 0.5) calc(100% - var(--feather) * 0.5),
        rgb(0 0 0 / 0.16) calc(100% - var(--feather) * 0.25),
        transparent
      );
    }

    .hero__sky-side {
      position: absolute;
      inset: 0;
      background:
        var(--sky-left) left / 50% 100% no-repeat,
        var(--sky-right) right / 50% 100% no-repeat;
    }

    /* Stars stop at each side's horizon: the foothills on the left, the dark slope on the right. */
    .hero__sky-side::before {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--sky-stars) 50% 0 / auto 100% repeat-x;
      mask-image:
        linear-gradient(to bottom, #000 64%, transparent 75%),
        linear-gradient(to bottom, #000 41%, transparent 52%);
      mask-size: 50% 100%;
      mask-position: left, right;
      mask-repeat: no-repeat;
    }
  }

  .hero__glow {
    position: absolute;
    top: 0;
    left: calc(50% - 640 * var(--u));
    width: calc(1280 * var(--u));
    height: calc(var(--glow-height) * var(--u));
    background-image: var(--glow);
    will-change: transform;
    animation: glow-in 1.8s var(--ease-out) both;
  }

  /* ---- Content ---- */
  .hero__content {
    position: absolute;
    inset: 0;
    z-index: var(--z-content);
    text-align: center;
  }

  .presents,
  .tagline {
    position: absolute;
    inset-inline: 0;
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: calc(32 * var(--u));
    line-height: 1;
  }

  .presents {
    top: calc(146 * var(--u));
    animation: rise 0.9s var(--ease-out) 0.1s both;
  }

  .title {
    position: absolute;
    top: calc(239 * var(--u));
    /* The glyph ink sits 2px right of the box centre; nudge it onto x = 640. */
    left: calc(50% - 2.25 * var(--u));
    margin: 0;
    translate: -50% 0;
    font-family: var(--font-display);
    font-weight: 400;
    /* --t = one mockup pixel at the title's current size (blur scales with the type). */
    --t: var(--u);
    font-size: calc(172.5 * var(--t));
    line-height: 1;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .title__ink {
    position: relative;
    display: block;
    color: #fff;
    filter: blur(calc(0.5 * var(--t)));
    animation: fade 0.7s ease-out 0.25s both;
  }

  /* Colour copies scale about the word centre: fringes grow toward the ends. */
  .title__ca {
    position: absolute;
    inset: 0;
    filter: blur(calc(1.2 * var(--t)));
    transform: scaleX(var(--ca));
    animation: ca-converge 1.5s var(--ease-out) 0.2s both;
  }

  .title__ca--amber {
    --ca: 1.04;
    --ca-from: 1.2;
    color: var(--c-amber);
  }

  .title__ca--red {
    --ca: 1.075;
    --ca-from: 1.34;
    color: var(--c-red);
  }

  .tagline {
    top: calc(403.5 * var(--u));
    /* Mockup spacing: slightly wider word gaps, line sits ~4px left of centre
       (fitted to the ink edges of each word, tuned for Haptic Serif). */
    word-spacing: 0.05em;
    translate: calc(-4.25 * var(--u)) 0;
    animation: rise 0.9s var(--ease-out) 0.45s both;
  }

  /* "portable": Onest Black; the colour copies are stretched vertically, giving
     red/amber fringes above and below the letters (not inside the counters). */
  .portable {
    --p: var(--u);
    position: relative;
    display: inline-block;
    font-family: var(--font-sans);
    font-weight: 900;
  }

  .portable__ink {
    position: relative;
  }

  .portable__ca {
    position: absolute;
    inset: 0;
    transform: scaleY(var(--cy));
    transform-origin: 50% 62%;
    filter: blur(calc(1.3 * var(--p)));
  }

  .portable__ca--red {
    --cy: 1.42;
    color: var(--c-red);
  }

  .portable__ca--amber {
    --cy: 1.15;
    color: var(--c-amber);
  }

  .scroll {
    position: absolute;
    top: calc(524 * var(--u));
    left: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    translate: -50% 0;
    font-size: calc(24 * var(--u));
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.009em;
    white-space: nowrap;
    animation: rise 0.9s var(--ease-out) 0.7s both;
  }

  .scroll__chevron {
    width: calc(14 * var(--u));
    height: auto;
    min-width: 11px;
    margin-top: calc(1.4 * var(--u));
  }

  @media (prefers-reduced-motion: no-preference) {
    .scroll__chevron {
      animation: bob 2.4s ease-in-out 1.8s 2;
    }
  }

  /* ---- Editor window (above the grain: screenshots are noise-free) ---- */
  .hero__window {
    position: absolute;
    top: calc(577.5 * var(--u));
    left: calc(50% - 511 * var(--u));
    width: calc(1022 * var(--u));
    height: calc(686 * var(--u));
    z-index: var(--z-media);
    overflow: hidden;
    border-radius: calc(12 * var(--u));
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.45);
    animation: rise-lg 1.1s var(--ease-out) 0.55s both;
  }

  /* The screenshot includes the iPad status bar (61 of 1640 px): crop it. */
  .hero__window-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: bottom;
  }

  /* ---- Entrance animations (end state = natural state; reduced-motion safe) ---- */
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(calc(12 * var(--u)));
    }
  }

  @keyframes rise-lg {
    from {
      opacity: 0;
      transform: translateY(calc(28 * var(--u)));
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  @keyframes glow-in {
    from {
      opacity: 0;
    }
  }

  @keyframes ca-converge {
    from {
      opacity: 0;
      transform: scaleX(var(--ca-from));
    }
  }

  @keyframes bob {
    50% {
      transform: translateY(calc(4 * var(--u)));
    }
  }

  /* ---- Mobile / tablet portrait: stacked layout ---- */
  @media (max-width: 820px) {
    .hero {
      /* Title size and the resulting vertical rhythm, so the glow can follow it. */
      --m-title: min(27vw, 200px);
      --m-title-mid: calc(134px + var(--m-title) / 2);
      --m-text: clamp(24px, 3.4vw, 28px);
      --m-window-top: calc(248px + 2 * var(--m-text) + var(--m-title));
      --m-span: calc(var(--m-window-top) - var(--m-title-mid));

      height: auto;
      padding-top: 92px;
    }

    .hero__sky,
    .hero__sky-photo {
      height: 640px;
    }

    .hero__sky-img {
      height: 100%;
      object-fit: cover;
      object-position: 64% 40%;
    }

    /* The glow is stretched so its title band (y 315 in the mockup) sits behind
       the title and its pink floor (y 600, i.e. 285 further down) lands just
       above the editor window: --m-span is that distance in real pixels. */
    .hero__glow {
      --k: 175vw;
      top: calc(var(--m-title-mid) - var(--m-span) * 315 / 285);
      left: calc(50% - var(--k) / 2);
      width: var(--k);
      height: calc(var(--m-span) * var(--glow-height) / 285);
    }

    .hero__content {
      position: relative;
      inset: auto;
    }

    .presents,
    .tagline,
    .scroll {
      position: relative;
      inset: auto;
      top: auto;
      left: auto;
      translate: none;
      word-spacing: normal;
    }

    .presents,
    .tagline {
      font-size: var(--m-text);
    }

    .title {
      position: relative;
      top: auto;
      left: auto;
      translate: none;
      display: inline-block;
      margin-top: 22px;
      --t: calc(var(--m-title) / 172.5);
    }

    .tagline {
      margin-top: 18px;
    }

    .portable {
      --p: calc(var(--m-text) / 32);
    }


    .scroll {
      width: fit-content;
      margin: 56px auto 0;
      padding-inline: 12px;
      font-size: clamp(17px, 2.6vw, 21px);
      gap: 6px;
    }

    .scroll__chevron {
      margin-top: 0;
    }

    .hero__window {
      position: relative;
      top: auto;
      left: auto;
      width: auto;
      height: auto;
      margin: 26px var(--gutter) 0;
      border-radius: 10px;
    }

    .hero__window-img {
      height: auto;
      aspect-ratio: 2360 / 1579;
    }
  }

  /* High-contrast modes: drop the decorative colour copies, keep the white text. */
  @media (forced-colors: active) {
    .title__ca,
    .portable__ca {
      display: none;
    }
  }
</style>
