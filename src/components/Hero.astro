---
/**
 * Hero: night sky + CSS aurora glow, the HAPTIC wordmark with its lens-style
 * chromatic aberration, and the editor window. Everything except the sky photo
 * and the editor screenshot is drawn in CSS/SVG. Desktop values are mockup
 * pixels written as calc(N * var(--u)); ≤ 820px switches to a stacked layout.
 */
import { Picture } from 'astro:assets';
import Grain from './Grain.astro';
import nightSky from '../assets/bg/night-sky.jpg';
import editorTablet from '../assets/editor/editor-tablet.jpg';
import { glowBackground, GLOW_WIDTH, GLOW_HEIGHT } from './hero/glow';

const glow = glowBackground();
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__sky" data-parallax="0.06">
      <Picture
        class="hero__sky-img"
        src={nightSky}
        alt=""
        widths={[800, 1280, 1920, 2560]}
        sizes="100vw"
        formats={['avif', 'webp']}
        quality={80}
        loading="eager"
        decoding="async"
      />
    </div>
    <div
      class="hero__glow"
      data-parallax="0.12"
      style={`--glow: ${glow}; --glow-ratio: ${GLOW_HEIGHT / GLOW_WIDTH}`}
    >
    </div>
  </div>

  <Grain />

  <div class="hero__content">
    <p class="presents">Hideout Presents</p>

    <h1 id="hero-title" class="title">
      <span class="title__ca title__ca--red" aria-hidden="true">HAPTIC</span>
      <span class="title__ca title__ca--amber" aria-hidden="true">HAPTIC</span>
      <span class="title__ink">HAPTIC</span>
    </h1>

    <p class="tagline">the <strong class="portable">portable</strong> game engine</p>

    <a class="scroll" href="#anywhere">
      <span class="scroll__label">Scroll to find out more</span>
      <svg class="scroll__chevron" viewBox="0 0 14 8" width="14" height="8" aria-hidden="true" focusable="false">
        <path d="M0.75 0.75 7 6.75 13.25 0.75" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>

  <div class="hero__window">
    <Picture
      class="hero__window-img"
      src={editorTablet}
      alt="The Haptic editor on iPad: a component tree on the left, a visual-scripting event graph in the middle and the inspector on the right."
      widths={[1024, 1536, 2048, 2360]}
      sizes="(max-width: 820px) calc(100vw - 48px), min(80vw, 1280px)"
      formats={['avif', 'webp']}
      quality={82}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>
</section>

<script>
  import { initHeroParallax } from './hero/hero-motion';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) initHeroParallax(hero);
</script>

<style>
  .hero {
    position: relative;
    height: calc(1263 * var(--u));
    color: var(--c-text);
  }

  /* ---- Background: sky photo + CSS glow (clipped; parallax moves inside) ---- */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: var(--z-bg);
    overflow: clip;
    background: var(--c-bg);
  }

  .hero__sky {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    will-change: transform;
    /* The photo's dark foreground melts into the page colour. */
    mask-image: linear-gradient(to bottom, #000 82%, transparent);
  }

  .hero__sky-img {
    width: 100%;
    height: auto;
  }

  .hero__glow {
    position: absolute;
    top: 0;
    left: calc(50% - 640 * var(--u));
    width: calc(1280 * var(--u));
    aspect-ratio: 1 / var(--glow-ratio);
    background-image: var(--glow);
    will-change: transform;
    animation: glow-in 1.8s var(--ease-out) both;
  }

  /* ---- Content ---- */
  .hero__content {
    position: absolute;
    inset: 0;
    z-index: var(--z-content);
    text-align: center;
    pointer-events: none;
  }

  .hero__content > * {
    pointer-events: auto;
  }

  .presents,
  .tagline {
    position: absolute;
    inset-inline: 0;
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: calc(32 * var(--u));
    line-height: 1;
  }

  .presents {
    top: calc(147 * var(--u));
    animation: rise 0.9s var(--ease-out) 0.1s both;
  }

  .title {
    position: absolute;
    top: calc(239 * var(--u));
    /* The glyph ink sits 2px right of the box centre; nudge it onto x = 640. */
    left: calc(50% - 2.25 * var(--u));
    margin: 0;
    translate: -50% 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: calc(172 * var(--u));
    line-height: 1;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .title__ink {
    position: relative;
    display: block;
    color: #fff;
    filter: blur(calc(0.7 * var(--u)));
    animation: fade 0.7s ease-out 0.25s both;
  }

  /* Colour copies scale about the word centre: fringes grow toward the ends. */
  .title__ca {
    position: absolute;
    inset: 0;
    filter: blur(calc(1.2 * var(--u)));
    transform: scaleX(var(--ca));
    animation: ca-converge 1.5s var(--ease-out) 0.2s both;
  }

  .title__ca--amber {
    --ca: 1.045;
    --ca-from: 1.2;
    color: var(--c-amber);
  }

  .title__ca--red {
    --ca: 1.08;
    --ca-from: 1.34;
    color: var(--c-red);
  }

  .tagline {
    top: calc(405.5 * var(--u));
    /* Mockup spacing: slightly wider word gaps, line sits ~5px left of centre. */
    word-spacing: 0.055em;
    translate: calc(-4.75 * var(--u)) 0;
    animation: rise 0.9s var(--ease-out) 0.45s both;
  }

  /* "portable": Onest Black with vertical red/amber fringes. */
  .portable {
    font-family: var(--font-sans);
    font-weight: 900;
    text-shadow:
      0 calc(-5 * var(--u)) calc(2.5 * var(--u)) var(--c-red),
      0 calc(5 * var(--u)) calc(2.5 * var(--u)) var(--c-red),
      0 calc(-2.6 * var(--u)) calc(1.6 * var(--u)) var(--c-amber),
      0 calc(2.6 * var(--u)) calc(1.6 * var(--u)) var(--c-amber);
  }

  .scroll {
    position: absolute;
    top: calc(524 * var(--u));
    left: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    translate: -50% 0;
    font-size: calc(24 * var(--u));
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.006em;
    white-space: nowrap;
    animation: rise 0.9s var(--ease-out) 0.7s both;
  }

  .scroll__chevron {
    width: calc(14 * var(--u));
    height: auto;
    min-width: 11px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .scroll__chevron {
      animation: bob 2.4s ease-in-out 1.8s infinite;
    }
  }

  /* ---- Editor window (above the grain: screenshots are noise-free) ---- */
  .hero__window {
    position: absolute;
    top: calc(577.5 * var(--u));
    left: calc(50% - 512 * var(--u));
    width: calc(1024 * var(--u));
    z-index: var(--z-media);
    overflow: hidden;
    border-radius: calc(12 * var(--u));
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08),
      0 calc(24 * var(--u)) calc(64 * var(--u)) rgb(0 0 0 / 0.35);
    animation: rise-lg 1.1s var(--ease-out) 0.55s both;
  }

  /* The screenshot includes the iPad status bar (61 of 1640 px): crop it. */
  .hero__window-img {
    width: 100%;
    height: auto;
    aspect-ratio: 2360 / 1579;
    object-fit: cover;
    object-position: bottom;
  }

  /* ---- Entrance animations (end state = natural state; reduced-motion safe) ---- */
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(calc(12 * var(--u)));
    }
  }

  @keyframes rise-lg {
    from {
      opacity: 0;
      transform: translateY(calc(28 * var(--u)));
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  @keyframes glow-in {
    from {
      opacity: 0;
    }
  }

  @keyframes ca-converge {
    from {
      opacity: 0;
      transform: scaleX(var(--ca-from));
    }
  }

  @keyframes bob {
    50% {
      transform: translateY(calc(4 * var(--u)));
    }
  }

  /* ---- Mobile / tablet portrait: stacked layout ---- */
  @media (max-width: 820px) {
    .hero {
      height: auto;
      padding-top: 92px;
    }

    .hero__sky {
      height: 640px;
    }

    .hero__sky-img {
      height: 100%;
      object-fit: cover;
      object-position: 64% 40%;
    }

    .hero__glow {
      --k: 175vw;
      top: 56px;
      left: calc(50% - var(--k) / 2);
      width: var(--k);
    }

    .hero__content {
      position: relative;
      inset: auto;
    }

    .presents,
    .tagline,
    .scroll {
      position: relative;
      inset: auto;
      top: auto;
      left: auto;
      translate: none;
    }

    .presents {
      font-size: 20px;
    }

    .title {
      position: relative;
      top: auto;
      left: auto;
      translate: none;
      display: inline-block;
      margin-top: 22px;
      font-size: min(27vw, 230px);
    }

    .tagline {
      margin-top: 18px;
      font-size: 20px;
    }

    .portable {
      text-shadow:
        0 -3px 1.6px var(--c-red),
        0 3px 1.6px var(--c-red),
        0 -1.6px 1px var(--c-amber),
        0 1.6px 1px var(--c-amber);
    }

    .scroll {
      margin: 56px auto 0;
      font-size: 17px;
      gap: 6px;
    }

    .hero__window {
      position: relative;
      top: auto;
      left: auto;
      width: auto;
      margin: 26px var(--gutter) 0;
      border-radius: 10px;
    }
  }
</style>
