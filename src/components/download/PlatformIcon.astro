---
/**
 * Brand marks as inline SVG, filled with currentColor. Paths come from
 * simple-icons (CC0); it has no Windows mark, so that one is drawn here.
 */
import { siApple, siLinux } from 'simple-icons';
import type { IconName } from '../../data/downloads';

interface Props {
  name: IconName;
}

const PATHS: Record<IconName, string> = {
  apple: siApple.path,
  linux: siLinux.path,
  // Windows 11 mark: four panes with a hairline gap.
  windows: 'M2 2h9.5v9.5H2zM12.5 2H22v9.5h-9.5zM2 12.5h9.5V22H2zM12.5 12.5H22V22h-9.5z',
};

const { name } = Astro.props;
---

<svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
  <path d={PATHS[name]}></path>
</svg>

<style>
  .icon {
    width: 1em;
    height: 1em;
    flex: none;
  }
</style>
