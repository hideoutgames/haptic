---
/**
 * A list of questions and answers as native disclosure widgets (<details>):
 * keyboard and screen readers work without any script. A small muted label
 * names the list; a plus beside each question folds into a minus when it is
 * open, and the answer slides in.
 *
 * Answers may hold simple inline HTML (links). Pass `class` to place the list:
 * the caller's scope attribute comes through with the other attributes, so its
 * scoped styles (margins) reach the section.
 */
import type { HTMLAttributes } from 'astro/types';

export interface FaqItem {
  q: string;
  /** Inline HTML. */
  a: string;
}

type Props = HTMLAttributes<'section'> & {
  /** The label above the list (also the section's accessible name). */
  title: string;
  items: FaqItem[];
};

const { title, items, id = 'faq', class: className, ...attrs } = Astro.props;
const titleId = `${id}-title`;
---

<section class:list={['faq', className]} id={id} aria-labelledby={titleId} {...attrs}>
  <h2 id={titleId} class="label">{title}</h2>
  <div class="faq__list">
    {
      items.map(({ q, a }) => (
        <details class="qa">
          <summary class="qa__q">
            <span>{q}</span>
            <span class="qa__icon" aria-hidden="true" />
          </summary>
          <p class="qa__a" set:html={a} />
        </details>
      ))
    }
  </div>
</section>

<style>
  .label {
    margin: 0 0 calc(14 * var(--u));
    font-size: max(14px, calc(15 * var(--u)));
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--c-text-muted);
  }

  .faq__list {
    border-bottom: 1px solid rgb(255 255 255 / 0.14);
  }

  .qa {
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }

  .qa__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(24 * var(--u));
    padding: calc(24 * var(--u)) 0;
    font-size: max(18px, calc(22 * var(--u)));
    font-weight: 500;
    line-height: 1.3;
    list-style: none;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .qa__q::-webkit-details-marker {
    display: none;
  }

  @media (hover: hover) {
    .qa__q:hover {
      color: rgb(255 255 255 / 0.8);
    }
  }

  .qa__q:focus-visible {
    outline-offset: 4px;
  }

  /* Plus that becomes a minus: the vertical stroke folds away. */
  .qa__icon {
    position: relative;
    flex: none;
    width: max(14px, calc(16 * var(--u)));
    height: max(14px, calc(16 * var(--u)));
  }

  .qa__icon::before,
  .qa__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    margin-top: -0.75px;
    border-radius: 1px;
    background: currentColor;
    transition: transform 0.3s var(--ease-out);
  }

  .qa__icon::after {
    transform: rotate(90deg);
  }

  .qa[open] .qa__icon::after {
    transform: rotate(90deg) scaleX(0);
  }

  .qa__a {
    max-width: calc(680 * var(--u));
    margin: 0;
    padding: 0 0 calc(26 * var(--u));
    font-size: max(16px, calc(18 * var(--u)));
    line-height: 1.6;
    color: rgb(255 255 255 / 0.72);
  }

  .qa[open] .qa__a {
    animation: qa-in 0.35s var(--ease-out);
  }

  .qa__a :global(a) {
    color: var(--c-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: rgb(255 255 255 / 0.5);
    transition: text-decoration-color 0.2s ease;
  }

  .qa__a :global(a:hover) {
    text-decoration-color: currentColor;
  }

  @keyframes qa-in {
    from {
      opacity: 0;
      transform: translateY(calc(-6 * var(--u)));
    }
  }

  /* ---- Phones / tablet portrait: --u is far below 1px, so fixed sizes; answers up to a readable 40em ---- */
  @media (max-width: 820px) {
    .label {
      margin-bottom: 10px;
    }

    .qa__q {
      gap: 16px;
      padding: 20px 0;
    }

    .qa__a {
      max-width: 40em;
      padding-bottom: 22px;
    }
  }
</style>
