---
/**
 * The popover under the logo: surface + notch (two siblings so each can carry
 * its own backdrop-filter) and the link content, two titled columns over a
 * footer row. Visibility is driven by the `data-open` attribute on the header,
 * set by header.ts.
 */
import { withBase } from '../../lib/paths';
import NorwayFlag from './NorwayFlag.astro';

interface MenuLink {
  label: string;
  /** Site-relative path without the deploy base, or a plain #fragment. */
  href: string;
}

interface Props {
  id: string;
  /** "Haptic Engine" column: the site's pages. */
  pages: MenuLink[];
  /** "Learning Center" column. */
  learning: MenuLink[];
  /** Current page path, also without the deploy base. */
  currentPath: string;
}

const { id, pages, learning, currentPath } = Astro.props;

const columns = [
  { key: 'engine', title: 'Haptic Engine', links: pages },
  { key: 'learning', title: 'Learning Center', links: learning },
];
---

<svg class="defs" width="0" height="0" aria-hidden="true" focusable="false">
  <!--
    Notch outline taken from the designer's popover SVG, in bounding-box units
    of an 85 × 18.24 px box: concave fillets into the panel's top edge, straight
    flanks and a rounded tip rising 17.74px. The last 0.5px tucks under the
    panel so the two translucent pieces never show a seam.
  -->
  <clipPath id="menu-notch" clipPathUnits="objectBoundingBox">
    <path
      d="M0 .9726C.0694 .9726 .1376 .8824 .1966 .7137C.258 .5396 .3387 .3083 .4017 .1289C.462 -.043 .538 -.043 .5983 .1289C.6613 .3083 .742 .5396 .8034 .7137C.8624 .8824 .9306 .9726 1 .9726V1H0Z"
    ></path>
  </clipPath>
</svg>

<div class="menu" id={id} role="group" aria-label="Site menu" tabindex="-1">
  <div class="menu__notch" aria-hidden="true"></div>
  <div class="menu__surface" aria-hidden="true"></div>

  {/* data-lenis-prevent: the panel scrolls on short screens; Lenis would otherwise turn the wheel into page scroll. */}
  <div class="menu__body" data-lenis-prevent>
    {
      columns.map((column) => (
        <nav class={`menu__col menu__col--${column.key}`} aria-labelledby={`${id}-${column.key}`}>
          <p class="menu__title" id={`${id}-${column.key}`}>
            {column.title}
          </p>
          <ul>
            {column.links.map((link) => (
              <li>
                {/* The current page is marked for assistive tech only; the mockup shows no visual cue. */}
                <a
                  class="menu__link"
                  href={withBase(link.href)}
                  aria-current={link.href === currentPath ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <div class="menu__foot">
      <a class="menu__link" href="https://hideout.no">Hideout</a>
      <span class="menu__country"><NorwayFlag />Norway</span>
    </div>
  </div>
</div>

<style>
  /* Sizes are authored at the 1280px mockup and scale with --m (see SiteHeader). */
  .defs {
    position: absolute;
    pointer-events: none;
  }

  .menu {
    --w: calc(497.5 * var(--m));
    --pad-l: calc(23 * var(--m));
    --pad-r: calc(24 * var(--m));
    --row: calc(33 * var(--m));
    /* Column titles and the country: the mockup's quiet grey. */
    --muted: rgb(138 138 139);
    /* Nearly opaque: the hero's giant lettering must not read through the panel. */
    --fill-a: 0.985;
    --fill-top: 24 25 27;
    position: absolute;
    top: calc(var(--safe-top) + 77 * var(--m));
    left: 50%;
    width: var(--w);
    margin-left: calc(var(--w) / -2);
    font-size: calc(18 * var(--m));
    line-height: var(--row);
    color: var(--c-text);
    outline: none;
    /* Grows out of the notch; no opacity/filter here, either would stop the
       children's backdrop-filter from seeing the page behind. Closing is quick;
       opening (below) runs alongside the H's turn into the bar. */
    transform-origin: 50% 0;
    transform: scale(0.94) translateY(calc(-6 * var(--m)));
    visibility: hidden;
    pointer-events: none;
    transition:
      transform 0.2s var(--ease-out),
      visibility 0s linear 0.2s;
  }

  :global([data-open]) .menu {
    transform: none;
    visibility: visible;
    pointer-events: auto;
    transition:
      transform 0.42s var(--ease-out) 0.05s,
      visibility 0s;
  }

  .menu__surface,
  .menu__notch {
    position: absolute;
    -webkit-backdrop-filter: blur(calc(40 * var(--m))) saturate(1.2);
    backdrop-filter: blur(calc(40 * var(--m))) saturate(1.2);
    opacity: 0;
    transition: opacity 0.18s ease;
  }

  .menu__surface {
    inset: 0;
    border-radius: calc(16 * var(--m));
    /* Dark at the top, warming toward the bottom like the mockup's glass over the
       hero glow; baked in because so little of the backdrop shows through. Stops
       are the mockup's tones less the ~2 levels the glow adds through the 1.5%
       translucency. */
    background: linear-gradient(
      rgb(var(--fill-top) / var(--fill-a)),
      rgb(36 35 31 / var(--fill-a)) 25%,
      rgb(50 43 36 / var(--fill-a)) 46%,
      rgb(52 48 44 / var(--fill-a)) 56%,
      rgb(53 46 43 / var(--fill-a)) 66%,
      rgb(50 41 37 / var(--fill-a)) 76%,
      rgb(49 37 34 / var(--fill-a)) 84%,
      rgb(47 35 34 / var(--fill-a)) 92%,
      rgb(45 31 32 / var(--fill-a))
    );
    box-shadow: 0 calc(14 * var(--m)) calc(40 * var(--m)) rgb(0 0 0 / 0.28);
  }

  .menu__notch {
    left: 50%;
    width: calc(85 * var(--m));
    margin-left: calc(-42.5 * var(--m));
    height: calc(18.24 * var(--m));
    bottom: calc(100% - 0.5 * var(--m));
    background: rgb(var(--fill-top) / var(--fill-a));
    clip-path: url(#menu-notch);
  }

  .menu__body {
    position: relative;
    display: grid;
    grid-template-columns: calc(224 * var(--m)) 1fr;
    padding: calc(23.4 * var(--m)) var(--pad-r) calc(14.8 * var(--m)) var(--pad-l);
    /* Short windows: scroll inside the panel (the notch sits outside it). */
    max-height: calc(100dvh - var(--safe-top) - 77 * var(--m) - 16px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgb(255 255 255 / 0.3) transparent;
    opacity: 0;
    transition: opacity 0.18s ease;
  }

  :global([data-open]) .menu__surface,
  :global([data-open]) .menu__notch,
  :global([data-open]) .menu__body {
    opacity: 1;
    transition: opacity 0.28s ease 0.05s;
  }

  .menu__body p,
  .menu__body ul {
    margin: 0;
  }

  .menu__body ul {
    padding: 0;
    list-style: none;
  }

  .menu__body .menu__title {
    margin-bottom: calc(27 * var(--m));
    color: var(--muted);
  }

  .menu__link {
    display: block;
    width: fit-content;
    text-underline-offset: calc(5 * var(--m));
    text-decoration-thickness: calc(2 * var(--m));
    text-decoration-color: transparent;
    transition: text-decoration-color 0.15s ease;
  }

  .menu__link:hover,
  .menu__link:focus-visible {
    text-decoration-line: underline;
    text-decoration-color: var(--c-amber);
  }

  .menu__link:focus-visible {
    outline-offset: calc(2 * var(--m));
  }

  .menu__foot {
    grid-column: 1 / -1;
    /* Footer row: four empty rows (131px in the mockup) below the last page link. */
    margin-top: calc(131 * var(--m));
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .menu__country {
    display: inline-flex;
    align-items: center;
    gap: calc(8 * var(--m));
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .menu {
      --w: min(497px, calc(100% - 32px));
      --pad-l: 22px;
      --pad-r: 22px;
    }

    .menu__body {
      grid-template-columns: max-content 1fr;
      column-gap: 24px;
      padding-top: 18px;
      padding-bottom: 10px;
    }

    .menu__body .menu__title {
      margin-bottom: 10px;
    }

    .menu__foot {
      margin-top: 44px;
    }

    /* Comfortable tap targets. */
    .menu__link {
      display: flex;
      align-items: center;
      min-height: 40px;
    }
  }

  /* Too narrow for both titles side by side (they need ~276px): stack the columns. */
  @media (max-width: 359px) {
    .menu__body {
      grid-template-columns: 1fr;
      row-gap: 20px;
    }

    .menu__foot {
      margin-top: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu {
      transform: none;
    }

    .menu,
    .menu__surface,
    .menu__notch,
    .menu__body {
      transition-duration: 0.12s !important;
    }

    :global([data-open]) .menu,
    :global([data-open]) .menu__surface,
    :global([data-open]) .menu__notch,
    :global([data-open]) .menu__body {
      transition-delay: 0s !important;
    }
  }
</style>
