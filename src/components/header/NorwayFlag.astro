---
// Norwegian flag in official proportions (22:16, Nordic cross offset to the hoist).
---

<svg class="flag" viewBox="0 0 22 16" aria-hidden="true" focusable="false">
  <rect width="22" height="16" fill="#ba0c2f"></rect>
  <path d="M6 0h4v16H6zM0 6h22v4H0z" fill="#fff"></path>
  <path d="M7 0h2v16H7zM0 7h22v2H0z" fill="#00205b"></path>
</svg>

<style>
  .flag {
    width: calc(22 * var(--m));
    height: calc(16 * var(--m));
    border-radius: calc(2 * var(--m));
    flex: none;
  }
</style>
