---
/**
 * "The engine you can bring anywhere": a pinned, scroll-scrubbed device
 * showcase (MacBook, then iPad, then iPhone). The timeline lives in
 * scripts/showcase.ts; this file holds the markup, the copy and the layout.
 *
 * Without JS, with reduced motion, or before the script runs, the section is
 * simply its final composition: all devices placed, all lines of copy listed.
 * The script switches it to `data-mode="pinned"`.
 *
 * Desktop measurements are mockup pixels written as calc(N * var(--k)), where
 * --k is --u capped by the viewport height so the composition always fits the
 * pinned screen. The MacBook is the layout anchor: the backdrop bands and the
 * text are positioned from the base of its frame (--ay).
 */
import Grain from './Grain.astro';
import Device from './showcase/Device.astro';
import { bandGradient } from './showcase/geometry';
import macFrame from '../assets/devices/macbook-pro-16-space-black.png';
import ipadFrame from '../assets/devices/ipad-pro-11-landscape-space-black.png';
import iphoneFrame from '../assets/devices/iphone-air-space-black.png';
import editorTablet from '../assets/editor/editor-tablet.jpg';
import editorPhone from '../assets/editor/editor-phone.jpg';

/** Draft copy, one line per scroll step. Edit freely; every line stays in the DOM. */
const HEADING = 'The engine you can bring anywhere';
const STEPS = [
  { label: 'Mac', copy: 'A full desktop editor for Mac, Windows and Linux.' },
  { label: 'iPad', copy: 'Built touch-first for iPad.' },
  { label: 'iPhone', copy: 'Tweak, test and play from your pocket.' },
];
---

<section id="anywhere" class="showcase" aria-labelledby="anywhere-title" data-showcase data-step="1">
  <script is:inline>
    // Hide the devices before first paint when the scroll sequence will run
    // (showcase.ts takes over from here and reverts this for reduced motion).
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.currentScript.parentElement.dataset.mode = 'pinned';
    }
  </script>

  <div class="stage" data-stage>
    <div class="stage__bg" style={`background: ${bandGradient()}`} aria-hidden="true"></div>
    <Grain />

    <div class="text">
      <h2 id="anywhere-title" class="title">{HEADING}</h2>

      <ul class="steps">
        {
          STEPS.map((step) => (
            <li class="step" data-copy>
              <span class="step__label">{step.label}</span>
              <span class="step__copy">{step.copy}</span>
            </li>
          ))
        }
      </ul>

      <div class="progress" aria-hidden="true">
        <ol class="progress__list">
          {STEPS.map((step) => <li>{step.label}</li>)}
        </ol>
        <span class="progress__track"><span class="progress__fill" data-progress></span></span>
      </div>
    </div>

    <div class="rig">
      <Device
        kind="mac"
        frame={macFrame}
        shot={editorTablet}
        alt="The Haptic editor on a MacBook Pro."
        frameWidths={[720, 1080, 1446, 1808]}
        shotWidths={[1180, 1760, 2360]}
        sizes="(max-width: 820px) 100vw, min(56.5vw, 904px)"
      />
      <Device
        kind="ipad"
        frame={ipadFrame}
        shot={editorTablet}
        alt="The Haptic editor on an iPad Pro."
        frameWidths={[520, 780, 1040]}
        shotWidths={[900, 1400, 2360]}
        sizes="(max-width: 820px) 72vw, min(32vw, 513px)"
      />
      <Device
        kind="iphone"
        frame={iphoneFrame}
        shot={editorPhone}
        alt="The Haptic editor on an iPhone."
        frameWidths={[240, 480, 720]}
        shotWidths={[375, 750]}
        sizes="(max-width: 820px) 31vw, min(14.5vw, 232px)"
      />
    </div>
  </div>
</section>

<script>
  import { initShowcase } from '../scripts/showcase';

  const showcase = document.querySelector<HTMLElement>('[data-showcase]');
  if (showcase) initShowcase(showcase);
</script>

<style>
  .showcase {
    /* Composition scale: the mockup's pixel, shrunk if the viewport is short. */
    --k: min(var(--u), calc(100svh * 0.00127));
    /* y of the MacBook base inside the pinned screen. */
    --ay: calc(100svh * 0.66);
    /* Scale of the backdrop bands (they follow the devices on desktop). */
    --kb: var(--k);
    --text-left: max(var(--gutter), calc((100vw - 1600px) / 2 + var(--gutter)));

    position: relative;
    color: var(--c-text);
  }

  .stage {
    position: relative;
    height: 100svh;
    min-height: 360px;
    overflow: clip;
    background: #0a0908;
  }

  .stage__bg {
    position: absolute;
    inset: 0;
    z-index: var(--z-bg);
  }

  /* ---- Copy ---- */
  .text {
    position: absolute;
    z-index: var(--z-content);
    left: var(--text-left);
    top: calc(var(--ay) - 401 * var(--k));
    width: calc(560 * var(--k));
  }

  .title,
  .step__copy {
    font-size: max(18px, calc(32 * var(--k)));
    font-weight: 500;
    line-height: 1.25;
  }

  .title {
    margin: 0;
  }

  .steps {
    margin: calc(24 * var(--k)) 0 0;
    padding: 0;
    list-style: none;
  }

  .step__copy {
    display: block;
  }

  /* Static (default): every device's line is listed with its name. */
  .step + .step {
    margin-top: calc(18 * var(--k));
  }

  .step__label {
    display: block;
    margin-bottom: calc(2 * var(--k));
    font-size: max(13px, calc(15 * var(--k)));
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  .step__copy {
    font-size: max(16px, calc(24 * var(--k)));
  }

  .progress {
    display: none;
  }

  /* ---- Pinned: one line at a time, crossfaded by the timeline ---- */
  [data-mode='pinned'] .steps {
    display: grid;
  }

  [data-mode='pinned'] .step {
    grid-area: 1 / 1;
    margin: 0;
  }

  [data-mode='pinned'] .step__copy {
    font-size: max(18px, calc(32 * var(--k)));
  }

  /* The device name stays for screen readers; the progress row shows it. */
  [data-mode='pinned'] .step__label {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  [data-mode='pinned'] .progress {
    display: block;
    width: fit-content;
    margin-top: calc(44 * var(--k));
  }

  .progress__list {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: max(14px, calc(16 * var(--k)));
    letter-spacing: 0.02em;
    color: rgb(255 255 255 / 0.4);
  }

  .progress__list li {
    transition: color 0.35s ease;
  }

  .progress__list li + li::before {
    content: '·';
    margin-inline: 0.7em;
    color: rgb(255 255 255 / 0.4);
  }

  [data-step='1'] .progress__list li:nth-child(1),
  [data-step='2'] .progress__list li:nth-child(2),
  [data-step='3'] .progress__list li:nth-child(3) {
    color: var(--c-text);
  }

  .progress__track {
    display: block;
    height: 1px;
    margin-top: calc(14 * var(--k));
    background: rgb(255 255 255 / 0.2);
    overflow: hidden;
  }

  .progress__fill {
    display: block;
    height: 100%;
    background: var(--c-text);
    transform-origin: left center;
    transform: scaleX(0);
  }

  /* ---- Devices: the MacBook frame is the rig; the others sit inside it ---- */
  .rig {
    position: absolute;
    z-index: var(--z-media);
    top: calc(var(--ay) - 479 * var(--k));
    right: calc(-134 * var(--k));
    width: calc(723 * var(--k));
    aspect-ratio: 4256 / 2834;
  }

  .rig :global(.device--mac) {
    inset: 0;
    width: 100%;
    z-index: 1;
  }

  .rig :global(.device--ipad) {
    left: 11%;
    top: 48%;
    width: 56.7%;
    z-index: 2;
  }

  .rig :global(.device--iphone) {
    left: -3.05%;
    top: 34.2%;
    width: 25.65%;
    z-index: 3;
  }

  /* Before the scroll script has run, the devices wait out of sight. */
  [data-mode='pinned'] .rig :global(.device) {
    opacity: 0;
    will-change: transform, opacity;
  }

  /* ---- Tablet portrait and phones: text on top, devices centred below ---- */
  @media (max-width: 820px) {
    .showcase {
      /* Rig width = 723 * k ≈ the viewport width. */
      --k: min(calc(100vw * 0.00138), calc(100svh * 0.00092));
      /* Taller bands than the devices, so the text sits in the blue. */
      --kb: calc(100svh / 940);
      /* Centre the group (MacBook + the devices hanging below it) under the
         text; never closer to the text than 300px. */
      --ay: max(calc(100svh - 337 * var(--k)), calc(300px + 479 * var(--k)));
    }

    .text {
      width: auto;
      right: var(--gutter);
      left: var(--gutter);
      top: 92px;
    }

    .title {
      font-size: clamp(22px, 5.8vw, 38px);
    }

    .steps {
      margin-top: 14px;
    }

    .step__copy,
    [data-mode='pinned'] .step__copy {
      font-size: clamp(17px, 4.5vw, 28px);
    }

    [data-mode='pinned'] .progress {
      margin-top: 22px;
    }

    .progress__list {
      font-size: clamp(14px, 3.6vw, 18px);
    }

    .rig {
      right: auto;
      left: calc(50% - 361.5 * var(--k));
    }

    .rig :global(.device--ipad) {
      left: 0;
      top: 50%;
      width: 72%;
    }

    .rig :global(.device--iphone) {
      left: 66%;
      top: 36%;
      width: 31%;
    }
  }
</style>
