---
/**
 * Page footer: brand line and legal notice on the left, the nav on the right
 * (one row on desktop, as in the mockup), then the oversized HAPTIC word
 * cropped by the bottom edge of the page (decorative, so aria-hidden).
 *
 * The text row uses the shared --u scale; the giant word is sized in vw, so its
 * crop stays identical at any width and it always runs off the right edge.
 * The legal line adds height to the row, which the giant word's top margin
 * gives back, so the footer keeps the mockup's overall proportions.
 *
 * Legal: Bru Development ENK is the company; Haptic is an unregistered
 * trademark (™, not ®). The year is computed when the site is built.
 */
import Grain from './Grain.astro';
import { withBase } from '../lib/paths';

const COMPANY = 'Bru Development ENK';
const YEAR = new Date().getFullYear();

const LINKS = [
  { label: 'Home', href: '/' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Signup', href: '/signup' },
  { label: 'About', href: '/about' },
];
---

<footer class="footer">
  <div class="row">
    <p class="brand">Haptic™, the portable game engine.</p>

    <nav class="nav" aria-label="Footer">
      <ul>
        {
          LINKS.map((link) => (
            <li>
              {link.label !== LINKS[0].label && (
                <span class="sep" aria-hidden="true">
                  &lt;&gt;
                </span>
              )}
              <a href={withBase(link.href)}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="legal">
      <span>&copy; {YEAR} <span class="co">{COMPANY}</span>.</span>
      <span>Haptic™ is a trademark of <span class="co">{COMPANY}</span>.</span>
    </p>
  </div>

  <div class="giant" aria-hidden="true">
    <span class="giant__word">HAPTIC</span>
  </div>

  <Grain />
</footer>

<style>
  .footer {
    --legal-size: max(13px, calc(15 * var(--u)));
    --legal-lh: 1.45;
    --legal-gap: calc(6 * var(--u));
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--c-bg);
  }

  /* Two lines on the left (brand, legal), the nav on the right sharing the brand line's baseline. */
  .row {
    position: relative;
    z-index: var(--z-content);
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'brand nav'
      'legal legal';
    align-items: baseline;
    column-gap: calc(48 * var(--u));
    row-gap: var(--legal-gap);
    /* Above 1600px the text keeps the centred 1280-unit composition; the giant word stays full-bleed. */
    width: min(100%, calc(1280 * var(--u)));
    margin-inline: auto;
    padding: calc(28.4 * var(--u)) calc(116 * var(--u)) 0 calc(115 * var(--u));
    font-size: calc(24 * var(--u));
    line-height: 1.2;
  }

  /* Hairline above the row, fading out at both ends. */
  .row::before {
    content: '';
    position: absolute;
    top: 0;
    left: calc(115 * var(--u));
    right: calc(116 * var(--u));
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.16) 14%, rgb(255 255 255 / 0.16) 86%, transparent);
  }

  .brand {
    grid-area: brand;
    margin: 0;
  }

  .legal {
    grid-area: legal;
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.9em;
    margin: 0;
    font-size: var(--legal-size);
    line-height: var(--legal-lh);
    letter-spacing: 0.005em;
    color: var(--c-text-muted);
  }

  /* A company name never breaks across lines. */
  .co {
    white-space: nowrap;
  }

  .nav {
    grid-area: nav;
  }

  .nav ul {
    display: flex;
    flex-wrap: wrap;
    row-gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Centre the separator on the link text (the touch rule below makes the link taller than its line). */
  .nav li {
    display: flex;
    align-items: center;
  }

  .nav a {
    text-underline-offset: 0.18em;
    text-decoration-thickness: 0.06em;
  }

  .nav a:hover {
    text-decoration-line: underline;
  }

  /* Spacing measured from the mockup; the first gap is a little wider. */
  .sep {
    margin: 0 calc(13 * var(--u));
  }

  .nav li:nth-child(2) .sep {
    margin-left: calc(20 * var(--u));
  }

  /* Giant word: 428px at 1280 (33.4vw). Only its top half shows (150.5px, 11.76vw).
     Above the grain layers: the mockup's glyph is a flat cut-out, the grain stays around it.
     The top margin is the mockup's 76.8 minus the legal line (and the gap above it) that the row now has extra. */
  .giant {
    position: relative;
    z-index: var(--z-media);
    height: calc(100vw * 150.5 / 1280);
    margin-top: calc(76.8 * var(--u) - var(--legal-size) * var(--legal-lh) - var(--legal-gap));
    overflow: hidden;
    color: var(--c-giant);
    user-select: none;
  }

  .giant__word {
    position: absolute;
    top: -0.0857em;
    left: -1.156vw;
    font-family: var(--font-display);
    font-size: 33.4vw;
    line-height: 1;
    white-space: nowrap;
  }

  @media (max-width: 820px) {
    .footer {
      --legal-gap: 14px;
    }

    .row {
      width: 100%;
      grid-template-columns: 1fr;
      grid-template-areas:
        'brand'
        'nav'
        'legal';
      justify-items: start;
      padding: 28px var(--gutter) 0;
      font-size: clamp(15px, 4.6vw, 22px);
    }

    .row::before {
      left: var(--gutter);
      right: var(--gutter);
    }

    .legal {
      flex-direction: column;
      column-gap: 0;
      font-size: max(13px, min(3.6vw, 15px));
    }

    /* The whole nav stays on one line down to 320px (about 19.6em wide), so no separator is stranded at a line start. */
    .nav {
      font-size: min(clamp(15px, 4.6vw, 22px), calc((100vw - 2 * var(--gutter)) / 19.6));
    }

    .sep {
      margin: 0 0.6em;
    }

    .nav li:nth-child(2) .sep {
      margin-left: 0.6em;
    }

    .giant {
      margin-top: 36px;
    }
  }

  /* Touch: grow the hit area to 44px; the negative margin keeps the layout as it was. */
  @media (max-width: 820px), (pointer: coarse) {
    .nav a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      margin-block: -12px;
    }
  }

  @media (forced-colors: active) {
    .row::before {
      background: GrayText;
    }
  }
</style>
