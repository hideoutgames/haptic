---
/**
 * Page footer: the legal notice on the left and the nav on the right, both in
 * the same small muted type (one row on desktop), then the oversized HAPTIC
 * word cropped by the bottom edge of the page (decorative, so aria-hidden).
 *
 * The text row uses the shared --u scale; the giant word is sized in vw, so its
 * crop stays identical at any width and it always runs off the right edge.
 * The row is centred where the mockup's footer line sits, and the giant word's
 * top margin keeps the footer at the mockup's overall height.
 *
 * Legal: Bru Development ENK is the company; Haptic is an unregistered
 * trademark (™, not ®). The year is computed when the site is built.
 */
import Grain from './Grain.astro';
import { withBase } from '../lib/paths';

const COMPANY = 'Bru Development ENK';
const YEAR = new Date().getFullYear();

const LINKS = [
  { label: 'Home', href: '/' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Signup', href: '/signup' },
  { label: 'About', href: '/about' },
];
---

<footer class="footer">
  <div class="row">
    <p class="legal">
      <span>&copy; {YEAR} <span class="co">{COMPANY}</span>.</span>
      <span>Haptic™ is a trademark of <span class="co">{COMPANY}</span>.</span>
    </p>

    <nav class="nav" aria-label="Footer">
      <ul>
        {
          LINKS.map((link) => (
            <li>
              <a href={withBase(link.href)}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="giant" aria-hidden="true">
    <span class="giant__word">HAPTIC</span>
  </div>

  <Grain />
</footer>

<style>
  .footer {
    --text-size: max(13px, calc(15 * var(--u)));
    --text-lh: 1.45;
    /* Centre of the text row, measured from the footer top (the mockup's footer line). */
    --row-mid: calc(42.8 * var(--u));
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--c-bg);
  }

  .row {
    position: relative;
    z-index: var(--z-content);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px calc(48 * var(--u));
    /* Above 1600px the text keeps the centred 1280-unit composition; the giant word stays full-bleed. */
    width: min(100%, calc(1280 * var(--u)));
    margin-inline: auto;
    padding: calc(var(--row-mid) - var(--text-size) * var(--text-lh) / 2) calc(116 * var(--u)) 0 calc(115 * var(--u));
    font-size: var(--text-size);
    line-height: var(--text-lh);
    letter-spacing: 0.005em;
    color: var(--c-text-muted);
  }

  /* Hairline above the row, fading out at both ends. */
  .row::before {
    content: '';
    position: absolute;
    top: 0;
    left: calc(115 * var(--u));
    right: calc(116 * var(--u));
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.16) 14%, rgb(255 255 255 / 0.16) 86%, transparent);
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.9em;
    margin: 0;
  }

  /* A company name never breaks across lines. */
  .co {
    white-space: nowrap;
  }

  .nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 1.6em;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a {
    color: inherit;
    text-underline-offset: 0.22em;
    text-decoration-thickness: 1px;
    transition: color 0.15s ease;
  }

  .nav a:hover {
    color: var(--c-text);
    text-decoration-line: underline;
  }

  /* Giant word: 428px at 1280 (33.4vw). Only its top half shows (150.5px, 11.76vw).
     Above the grain layers: the mockup's glyph is a flat cut-out, the grain stays around it.
     Its top sits 134u below the footer top, as in the mockup. */
  .giant {
    position: relative;
    z-index: var(--z-media);
    height: calc(100vw * 150.5 / 1280);
    margin-top: calc(134 * var(--u) - var(--row-mid) - var(--text-size) * var(--text-lh) / 2);
    overflow: hidden;
    color: var(--c-giant);
    user-select: none;
  }

  .giant__word {
    position: absolute;
    top: -0.0857em;
    left: -1.156vw;
    font-family: var(--font-display);
    font-size: 33.4vw;
    line-height: 1;
    white-space: nowrap;
  }

  @media (max-width: 820px) {
    .footer {
      --text-size: max(13px, min(3.6vw, 15px));
    }

    /* Stacked: nav first, the legal notice last. */
    .row {
      width: 100%;
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 14px;
      padding: 28px var(--gutter) 0;
    }

    .row::before {
      left: var(--gutter);
      right: var(--gutter);
    }

    .legal {
      flex-direction: column;
      column-gap: 0;
    }

    .giant {
      margin-top: 36px;
    }
  }

  /* Touch: grow the hit area to 44px; the negative margin keeps the layout as it was. */
  @media (max-width: 820px), (pointer: coarse) {
    .nav a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      margin-block: -12px;
    }
  }

  @media (forced-colors: active) {
    .row::before {
      background: GrayText;
    }
  }
</style>
