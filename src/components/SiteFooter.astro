---
/**
 * Page footer: two lines of small muted type, then the oversized HAPTIC word
 * cropped by the bottom edge of the page (decorative, so aria-hidden). On the
 * left the legal notice (copyright, then trademark); on the right the site
 * nav, with the links to the Terms of Service and the Privacy Policy under it.
 * Phones stack them: links first, the legal notice last.
 *
 * The text row uses the shared --u scale; the giant word is sized in vw, so its
 * crop stays identical at any width and it always runs off the right edge.
 * The first line is centred where the mockup's footer line sits; the second
 * hangs below it. The giant word sits 24u higher than in the mockup (its top
 * 110u below the footer top, not 134u, whatever the row holds), so the footer
 * is 260.5u tall at 1280 instead of 284.5u: the room lets the whole download
 * section fit above it on the last screen (DownloadSection).
 *
 * Legal: Bru Development ENK is the company; Haptic is an unregistered
 * trademark (™, not ®). The year is computed when the site is built.
 */
import Grain from './Grain.astro';
import { withBase } from '../lib/paths';

const COMPANY = 'Bru Development ENK';
const YEAR = new Date().getFullYear();

/** Site pages. The docs are not online yet: a plain fragment for now, as in the H menu. */
const LINKS = [
  { label: 'Home', href: '/' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Documentation', href: '#docs' },
  { label: 'Support', href: '/support' },
  { label: 'Signup', href: '/signup' },
  { label: 'About', href: '/about' },
];

/** The Terms of Service and the Privacy Policy (not written yet: they show the 404 page until they are). */
const POLICIES = [
  { label: 'Terms', href: '/terms' },
  { label: 'Privacy', href: '/privacy' },
];
---

<footer class="footer">
  <div class="row">
    <p class="legal">
      <span>&copy; {YEAR} <span class="co">{COMPANY}</span>.</span>
      <span>Haptic™ is a trademark of <span class="co">{COMPANY}</span>.</span>
    </p>

    <div class="links">
      <nav aria-label="Footer">
        <ul>
          {
            LINKS.map((link) => (
              <li>
                <a href={withBase(link.href)}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Legal">
        <ul>
          {
            POLICIES.map((link) => (
              <li>
                <a href={withBase(link.href)}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <div class="giant" aria-hidden="true">
    <span class="giant__word">HAPTIC</span>
  </div>

  <Grain />
</footer>

<style>
  .footer {
    --text-size: max(13px, calc(15 * var(--u)));
    --text-lh: 1.45;
    --line: calc(var(--text-size) * var(--text-lh));
    /* Centre of the text row, measured from the footer top (the mockup's footer line). */
    --row-mid: calc(42.8 * var(--u));
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--c-bg);
  }

  /* Two columns of two lines. When the row runs short (tablets), the legal
     notice wraps within itself and the links keep their lines, at the right. */
  .row {
    position: relative;
    z-index: var(--z-content);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    column-gap: calc(48 * var(--u));
    /* Above 1600px the text keeps the centred 1280-unit composition; the giant word stays full-bleed. */
    width: min(100%, calc(1280 * var(--u)));
    margin-inline: auto;
    padding: calc(var(--row-mid) - var(--line) / 2) calc(116 * var(--u)) 0 calc(115 * var(--u));
    font-size: var(--text-size);
    line-height: var(--text-lh);
    letter-spacing: 0.005em;
    color: var(--c-text-muted);
  }

  /* Hairline above the row, fading out at both ends. */
  .row::before {
    content: '';
    position: absolute;
    top: 0;
    left: calc(115 * var(--u));
    right: calc(116 * var(--u));
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.16) 14%, rgb(255 255 255 / 0.16) 86%, transparent);
  }

  .legal {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  /* A company name never breaks across lines. */
  .co {
    white-space: nowrap;
  }

  .links {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: flex-end;
  }

  .links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 1.6em;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    color: inherit;
    text-underline-offset: 0.22em;
    text-decoration-thickness: 1px;
    transition: color 0.15s ease;
  }

  .links a:hover {
    color: var(--c-text);
    text-decoration-line: underline;
  }

  /* Giant word: 428px at 1280 (33.4vw). Only its top half shows (150.5px, 11.76vw).
     Above the grain layers: the mockup's glyph is a flat cut-out, the grain stays around it.
     Its top sits 110u below the footer top (134u in the mockup: see above); the
     row's two lines end 1.5 lines below --row-mid. */
  .giant {
    position: relative;
    z-index: var(--z-media);
    height: calc(100vw * 150.5 / 1280);
    margin-top: calc(110 * var(--u) - var(--row-mid) - 1.5 * var(--line));
    overflow: hidden;
    color: var(--c-giant);
    user-select: none;
  }

  .giant__word {
    position: absolute;
    top: -0.0857em;
    left: -1.156vw;
    font-family: var(--font-display);
    font-size: 33.4vw;
    line-height: 1;
    white-space: nowrap;
  }

  @media (max-width: 820px) {
    .footer {
      --text-size: max(13px, min(3.6vw, 15px));
    }

    /* Stacked: the links first, the legal notice last. */
    .row {
      width: 100%;
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 14px;
      padding: 28px var(--gutter) 0;
    }

    .row::before {
      left: var(--gutter);
      right: var(--gutter);
    }

    .links {
      align-items: flex-start;
      row-gap: 4px;
    }

    .giant {
      margin-top: 36px;
    }
  }

  /* Touch: grow the hit area to 44px; the negative margin keeps each link one line tall. */
  @media (max-width: 820px), (pointer: coarse) {
    .links a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      margin-block: calc((var(--line) - 44px) / 2);
    }
  }

  @media (forced-colors: active) {
    .row::before {
      background: GrayText;
    }
  }
</style>
