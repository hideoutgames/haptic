---
/**
 * Intro preloader: a full-screen overlay with the HAPTIC wordmark, a circular
 * progress ring with the loaded amount (0–100), shown once per browser session while the
 * page's fonts, hero images and the 3D scene get ready (see scripts/preload.ts).
 *
 * Visible only while <html> has `is-loading`, which the inline script in
 * Base.astro sets before first paint (opt-in via `<Base preload>`, skipped when
 * sessionStorage has 'haptic:intro-seen', never set without JS). The wordmark
 * intro is plain CSS keyframes, so it plays from first paint without waiting for
 * any script; preloader/preloader.ts drives the ring and the reveal.
 *
 * Hand-off: the wordmark is the hero title, drawn a second time with the same
 * markup recipe (white ink over two scaled colour copies), the same font size and
 * the same position. preloader.ts re-reads the real title's box at runtime, so
 * the overlay can cross-fade to the hero without any jump. While the overlay is
 * up, the hero's own load-in is held (the global rules below) and its title is
 * already in place; everything else in the hero animates in when `ready` fires.
 */
import Grain from './Grain.astro';

const LETTERS = [...'HAPTIC'];
const word = LETTERS.map((ch, i) => ({ ch, i }));
---

<div class="pre" id="preloader" data-preloader>
  <div class="pre__bg" aria-hidden="true"></div>
  <div class="pre__glow" data-glow aria-hidden="true"></div>

  <div class="wm" aria-hidden="true">
    <span class="wm__ca wm__ca--red">{word.map(({ ch, i }) => <span class="ch" style={`--i:${i}`}>{ch}</span>)}</span>
    <span class="wm__ca wm__ca--amber">{word.map(({ ch, i }) => <span class="ch" style={`--i:${i}`}>{ch}</span>)}</span>
    <span class="wm__ink">{word.map(({ ch, i }) => <span class="ch" style={`--i:${i}`}>{ch}</span>)}</span>
  </div>

  <Grain />

  <div
    class="ring"
    role="progressbar"
    aria-label="Loading Haptic"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
  >
    <span class="ring__track"></span>
    <span class="ring__arc" data-arc></span>
    <span class="ring__num"><span class="ring__digits" data-digits>0</span></span>
  </div>
</div>

<script is:inline>
  // Runs before first paint (the overlay is the first thing in <body>), without
  // waiting for any bundled script.
  (function () {
    var p = document.getElementById('preloader');
    var d = document.documentElement;
    if (!p || !d.classList.contains('is-loading')) return;

    // The hero title is in its final state under the overlay (see the global rules below).
    d.setAttribute('data-handoff', '');

    // The ring and the count start (`is-go`) once the display font is ready, or after 0.9 s so
    // a slow connection still sees the page is alive. The wordmark's letters (`is-type`) wait
    // for the font itself: it is declared `font-display: block`, so until it arrives the
    // glyphs are invisible and an intro played meanwhile would be spent on nothing. Past the
    // end of the browser's block period (3 s) the fallback face shows, so they start anyway.
    var started = false;
    var typed = false;
    function go() {
      if (started) return;
      started = true;
      p.setAttribute('data-t0', String(performance.now()));
      p.classList.add('is-go');
    }
    function type() {
      if (typed) return;
      typed = true;
      clearTimeout(goTimer);
      clearTimeout(typeTimer);
      go();
      p.classList.add('is-type');
    }
    var goTimer = setTimeout(go, 900);
    var typeTimer = setTimeout(type, 3000);
    try {
      document.fonts.load('172px "Block Berthold"', 'HAPTIC').then(type, type);
    } catch (e) {
      type();
    }

    // Fail-safe if the bundled script never starts (blocked or failed chunk):
    // never leave the page locked behind the overlay.
    function bail() {
      if (!d.classList.contains('is-loading')) return;
      d.classList.remove('is-loading');
      p.hidden = true;
    }
    setTimeout(function () {
      if (p.hasAttribute('data-alive')) setTimeout(bail, 13000);
      else bail();
    }, 12000);
  })();
</script>

<script>
  import { initPreloader } from './preloader/preloader';

  const root = document.getElementById('preloader');
  if (root) initPreloader(root);
</script>

<!-- Page-level rules while the overlay is up (the hero lives in another component, so these are global). -->
<style is:global>
  /* Lock scrolling. The gutter stays reserved so the page does not shift when the lock lifts. */
  html.is-loading {
    overflow: hidden;
    scrollbar-gutter: stable;
    overscroll-behavior: none;
  }

  /* Hold the hero's load-in until the preloader releases the page (`ready`): the
     keyframes keep their "from" state meanwhile and start from zero afterwards. */
  html.is-loading .hero,
  html.is-loading .hero *,
  html.is-loading .hero *::before,
  html.is-loading .hero *::after {
    animation-play-state: paused !important;
  }

  /* The wordmark has already played the title's intro: the real title takes over
     in its final state, so the hand-off is a straight cross-fade of identical pixels. */
  html[data-handoff] .hero .title__ink,
  html[data-handoff] .hero .title__ca {
    animation: none !important;
  }
</style>

<style>
  .pre {
    /* Wordmark box: the hero title's position and size, as the hero's CSS computes
       them (desktop: mockup pixels; stacked layout ≤ 820px: below the first line).
       preloader.ts overrides these with the measured values of the real title. */
    --wm-x: calc(50% - 2.25 * var(--u));
    --wm-y: calc(239 * var(--u));
    --wm-fs: calc(172.5 * var(--u));
    --ring: clamp(56px, calc(64 * var(--u)), 72px);
    --pre-fade: 0.9s;

    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    overflow: hidden;
    color: var(--c-text);
    background: var(--c-bg);
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
    overscroll-behavior: none;
    cursor: progress;
  }

  @media (max-width: 820px) {
    .pre {
      --wm-x: 50%;
      --wm-y: calc(92px + clamp(24px, 3.4vw, 28px) + 22px);
      --wm-fs: min(27vw, 200px);
    }
  }

  :global(html.is-loading) .pre,
  .pre.is-revealing {
    display: block;
  }

  .pre[hidden] {
    display: none !important;
  }

  .pre__bg {
    position: absolute;
    inset: 0;
    background: var(--c-bg);
  }

  /* A faint warm bloom behind the wordmark that grows with the progress: a hint
     of the hero's glow, which takes over when the overlay fades. */
  .pre__glow {
    position: absolute;
    inset: 0;
    opacity: 0.3;
    background: radial-gradient(
      ellipse calc(var(--wm-fs) * 3.1) calc(var(--wm-fs) * 1.5) at 50% calc(var(--wm-y) + var(--wm-fs) * 0.7),
      rgb(214 96 34 / 0.2),
      rgb(188 44 98 / 0.1) 45%,
      transparent 78%
    );
  }

  /* ---- Reveal: the whole overlay cross-fades to the hero underneath ---- */
  .pre.is-revealing {
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--pre-fade) cubic-bezier(0.3, 0, 0.2, 1);
  }

  .pre.is-detached .wm {
    opacity: 0;
    transition: opacity 0.25s ease-out;
  }

  .pre.is-revealing .ring {
    opacity: 0;
    scale: 0.9;
    transition:
      opacity 0.32s ease-out,
      scale 0.5s var(--ease-out);
  }

  /* ---- Wordmark: the hero title's recipe (white ink, two scaled colour copies) ---- */
  .wm {
    position: absolute;
    z-index: var(--z-content);
    top: var(--wm-y);
    left: var(--wm-x);
    width: var(--wm-w, auto);
    translate: var(--wm-tx, -50%) 0;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--wm-fs);
    /* Blur radii are mockup pixels at the title's current size. */
    --t: calc(var(--wm-fs) / 172.5);
    line-height: 1;
    letter-spacing: 0;
    white-space: nowrap;
    /* The letters rise from behind the box's bottom edge. */
    clip-path: inset(-0.45em -0.45em 0 -0.45em);
  }

  .wm__ink {
    position: relative;
    display: block;
    color: #fff;
    filter: blur(calc(0.5 * var(--t)));
  }

  .wm__ca {
    position: absolute;
    inset: 0;
    filter: blur(calc(1.2 * var(--t)));
    transform: scaleX(var(--ca));
    animation: wm-converge 1.25s var(--ease-out) 0.12s backwards paused;
  }

  .wm__ca--amber {
    --ca: 1.04;
    --ca-from: 1.2;
    color: var(--c-amber);
  }

  .wm__ca--red {
    --ca: 1.075;
    --ca-from: 1.34;
    color: var(--c-red);
  }

  /* inline-block (not a plain inline span) so a letter can be moved; the font has
     no kerning pairs among H A P T I C, so the word keeps its natural width. */
  .ch {
    display: inline-block;
    animation: wm-rise 0.85s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i) * 70ms) backwards paused;
  }

  /* The ring starts with `is-go`, the wordmark with `is-type` (the font is ready); see the inline script. */
  .pre.is-type .ch,
  .pre.is-type .wm__ca,
  .pre.is-go .ring {
    animation-play-state: running;
  }

  @keyframes wm-rise {
    0% {
      opacity: 0;
      transform: translateY(0.9em);
    }
    30% {
      opacity: 1;
    }
  }

  @keyframes wm-converge {
    from {
      transform: scaleX(var(--ca-from));
    }
  }

  /* ---- Ring ---- */
  .ring {
    position: absolute;
    z-index: var(--z-media);
    left: 50%;
    top: min(
      calc(var(--wm-y) + var(--wm-fs) * 0.79 + max(28px, var(--wm-fs) * 0.3)),
      calc(100% - var(--ring) - 20px)
    );
    width: var(--ring);
    height: var(--ring);
    translate: -50% 0;
    animation: ring-in 0.7s var(--ease-out) 0.55s backwards paused;
  }

  .ring__track,
  .ring__arc {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }

  .ring__track {
    box-shadow: inset 0 0 0 2px rgb(255 255 255 / 0.14);
  }

  /* Amber at the start of the arc, red at its head (the brand's fringe colours). */
  .ring__arc {
    --p: 0;
    background: conic-gradient(
      from 0deg,
      var(--c-amber),
      var(--c-red) calc(var(--p) * 360deg),
      transparent calc(var(--p) * 360deg + 0.5deg)
    );
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 2.6px), #000 calc(100% - 1.6px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 2.6px), #000 calc(100% - 1.6px));
  }

  .ring__num {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(15px, calc(16 * var(--u)), 18px);
    line-height: 1;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
  }

  .ring__digits {
    display: inline-block;
  }

  @keyframes ring-in {
    from {
      opacity: 0;
      scale: 0.88;
    }
  }

  /* ---- Reduced motion: wordmark shown at once, ring still counts, quick fade ---- */
  @media (prefers-reduced-motion: reduce) {
    .ch,
    .wm__ca,
    .ring {
      animation: none;
    }
    .pre.is-revealing {
      transition-duration: 0.3s !important;
    }
    .pre.is-revealing .ring {
      transition-duration: 0.2s !important;
    }
  }

  @media (forced-colors: active) {
    .pre,
    .pre__bg {
      background: Canvas;
    }
    .wm__ca,
    .pre__glow {
      display: none;
    }
    .wm__ink,
    .ring__num {
      color: CanvasText;
    }
    .ring__arc {
      background: Highlight;
    }
  }

  @media print {
    .pre {
      display: none !important;
    }
  }
</style>
