---
/**
 * Pricing page: three plans side by side (stacked on phones), a few pricing
 * questions and a pointer to support, in the shell the secondary pages share
 * (layouts/Page.astro).
 *
 * Haptic is free on desktop (Mac, Windows, Linux) while the person or company
 * using it makes less than REVENUE_LIMIT a year in revenue. iPhone, iPad and
 * Android, and any use above that revenue, need Haptic Pro: one subscription
 * covers all of a person's devices, and teams need one per seat. Its price is
 * not set yet, so the card says so (PRO_PRICE: put the price there when it
 * is). No free trial. Enterprise is by arrangement, through the contact address.
 *
 * Buttons: the free plan goes to the download section on the home page, Haptic
 * Pro to the sign-up page, Enterprise to an email (CONTACT_EMAIL).
 *
 * Sizes are mockup pixels (calc(N * var(--u))) on desktop; ≤ 820px switches to
 * phone sizes.
 */
import Page from '../layouts/Page.astro';
import Faq, { type FaqItem } from '../components/Faq.astro';
import FringeButton from '../components/FringeButton.astro';
import { CONTACT_EMAIL, SUPPORT_EMAIL } from '../data/site';
import { withBase } from '../lib/paths';

/** Haptic Pro's price as shown on its card, or null while it is not set. */
const PRO_PRICE: string | null = null;

/** Yearly revenue above which Haptic needs a subscription, also on desktop. */
const REVENUE_LIMIT = '$50,000';

/** The limit with its period, kept on one line ("$50,000 a year"). */
const PER_YEAR = `${REVENUE_LIMIT}\u00a0a\u00a0year`;

interface Plan {
  id: 'free' | 'pro' | 'enterprise';
  for: string;
  name: string;
  /** The big line under the name; `muted` for words rather than a price. */
  price: { text: string; muted?: boolean };
  features: string[];
  cta: { label: string; href: string };
  /** Shown under the button (the enterprise contact address). */
  note?: string;
}

const PLANS: Plan[] = [
  {
    id: 'free',
    for: 'Desktop',
    name: 'Haptic',
    price: { text: 'Free' },
    features: ['The full desktop editor', 'Mac, Windows and Linux', `For revenue under ${PER_YEAR}`],
    cta: { label: 'Download', href: withBase('/#download') },
  },
  {
    id: 'pro',
    for: 'Phone and tablet',
    name: 'Haptic Pro',
    price: PRO_PRICE ? { text: PRO_PRICE } : { text: 'Price coming soon', muted: true },
    features: ['Haptic on iPhone, iPad and Android', 'One account for all your devices', `For revenue over ${PER_YEAR}`],
    cta: { label: 'Get started', href: withBase('/signup') },
  },
  {
    id: 'enterprise',
    for: 'Studios and large teams',
    name: 'Enterprise',
    price: { text: 'Let’s talk', muted: true },
    features: ['Everything in Haptic Pro', 'Seats for your whole team'],
    cta: { label: 'Contact', href: `mailto:${CONTACT_EMAIL}` },
    note: CONTACT_EMAIL,
  },
];

/** Answers may hold simple inline HTML (links). */
const FAQ: FaqItem[] = [
  {
    q: 'Do I need a subscription to use Haptic?',
    a: `Not on desktop: Haptic is free on Mac, Windows and Linux while you, or the company you work for, makes less than ${PER_YEAR} in revenue. To use it on iPhone, iPad or Android you need Haptic Pro.`,
  },
  {
    q: 'Does one subscription cover all my devices?',
    a: 'Yes. One Haptic Pro subscription covers every phone and tablet you sign in on with your account.',
  },
  {
    q: `What if I or my company make more than ${PER_YEAR}?`,
    a: `Then you need a Haptic Pro subscription, on desktop too. Teams need one subscription per seat: one for each person who uses Haptic. For a larger team, <a href="mailto:${CONTACT_EMAIL}">contact us</a> about Enterprise.`,
  },
];
---

<Page
  title="Pricing — Haptic"
  description="Haptic is free on Mac, Windows and Linux. Haptic Pro brings it to iPhone, iPad and Android."
  heading="Pricing"
  lead="Free on desktop. Haptic Pro for your phone and tablet."
  width={1120}
>
  <div class="plans">
    {
      PLANS.map((plan) => (
        <article class:list={['plan', `plan--${plan.id}`]} aria-labelledby={`plan-${plan.id}`}>
          <p class="plan__for">{plan.for}</p>
          <h2 class="plan__name" id={`plan-${plan.id}`}>
            {plan.name}
          </h2>
          <p class:list={['plan__price', { 'plan__price--muted': plan.price.muted }]}>{plan.price.text}</p>
          <ul class="plan__features">
            {plan.features.map((feature) => (
              <li>
                <svg class="plan__check" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
                  <path d="m3.25 8.25 3 3 6.5-6.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
          <div class="plan__foot">
            {plan.id === 'pro' ? (
              <FringeButton class="plan__cta" href={plan.cta.href}>
                <span>{plan.cta.label}</span>
              </FringeButton>
            ) : (
              <a class="plan__cta plan__cta--outline" href={plan.cta.href}>
                {plan.cta.label}
              </a>
            )}
          </div>
          {plan.note && <p class="plan__note">{plan.note}</p>}
        </article>
      ))
    }
  </div>

  <Faq class="pricing__faq" id="pricing-faq" title="Pricing questions" items={FAQ} />

  <p class="pricing__more">
    More questions? See <a href={withBase('/support')}>Support</a> or email <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>.
  </p>
</Page>

<style>
  /* ---- Plans ---- */
  /* The cards share their rows (subgrid): label, name, price, features, button,
     note. Names, prices, lists and buttons line up across the three, however
     the text wraps; only Enterprise has a note under its button. */
  .plans {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(6, auto);
    column-gap: calc(20 * var(--u));
    margin-top: calc(80 * var(--u));
  }

  .plan {
    --radius: calc(28 * var(--u));
    display: grid;
    grid-row: span 6;
    grid-template-rows: subgrid;
    row-gap: 0;
    padding: calc(36 * var(--u));
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.035);
  }

  /* Haptic Pro: a hairline in the fringe colours and a faint warm glow. */
  .plan--pro {
    border-color: transparent;
    background:
      linear-gradient(#0d0b0a, #0d0b0a) padding-box,
      linear-gradient(135deg, var(--c-amber), var(--c-red) 55%, rgb(255 255 255 / 0.12)) border-box;
    box-shadow: 0 0 calc(80 * var(--u)) rgb(255 90 30 / 0.1);
  }

  .plan__for {
    margin: 0;
    font-size: max(14px, calc(15 * var(--u)));
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--c-text-muted);
  }

  .plan__name {
    margin: calc(8 * var(--u)) 0 0;
    font-size: calc(32 * var(--u));
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  /* One line box tall in both cards, so the lists below line up. */
  .plan__price {
    display: flex;
    align-items: flex-end;
    min-height: calc(62 * var(--u));
    margin: calc(20 * var(--u)) 0 0;
    font-size: calc(56 * var(--u));
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  /* Words in place of a price (coming soon, let's talk). */
  .plan__price--muted {
    padding-bottom: calc(6 * var(--u));
    font-size: calc(28 * var(--u));
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--c-text-muted);
  }

  /* The row is as tall as the longest list; shorter lists stay packed at its top. */
  .plan__features {
    display: grid;
    align-content: start;
    gap: calc(12 * var(--u));
    margin: calc(28 * var(--u)) 0 0;
    padding: calc(28 * var(--u)) 0 0;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    list-style: none;
    font-size: max(16px, calc(18 * var(--u)));
    line-height: 1.4;
    color: rgb(255 255 255 / 0.82);
  }

  .plan__features li {
    display: flex;
    align-items: flex-start;
    gap: calc(12 * var(--u));
  }

  .plan__check {
    flex: none;
    width: 1em;
    height: 1em;
    margin-top: 0.2em;
    color: var(--c-text);
  }

  .plan--pro .plan__check {
    color: var(--c-amber);
  }

  .plan__foot {
    padding-top: calc(40 * var(--u));
  }

  /* The free plan's button: same size as the fringed one, outlined. */
  .plan__cta--outline {
    display: inline-flex;
    align-items: center;
    height: max(56px, calc(64 * var(--u)));
    padding: 0 max(26px, calc(32 * var(--u)));
    border: 1px solid rgb(255 255 255 / 0.32);
    border-radius: max(16px, calc(18 * var(--u)));
    font-size: max(18px, calc(21 * var(--u)));
    font-weight: 650;
    letter-spacing: -0.005em;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .plan__cta--outline:hover {
    border-color: rgb(255 255 255 / 0.55);
    background: rgb(255 255 255 / 0.08);
  }

  .plan__note {
    margin: calc(14 * var(--u)) 0 0;
    font-size: max(14px, calc(15 * var(--u)));
    color: var(--c-text-muted);
  }

  .plan__cta--outline:focus-visible {
    border-radius: max(16px, calc(18 * var(--u)));
    outline-offset: max(6px, calc(8 * var(--u)));
  }

  /* ---- Questions and the way to support ---- */
  .pricing__faq {
    margin-top: calc(112 * var(--u));
  }

  .pricing__more {
    margin: calc(40 * var(--u)) 0 0;
    font-size: max(16px, calc(18 * var(--u)));
    text-align: center;
    color: var(--c-text-muted);
  }

  .pricing__more a {
    color: var(--c-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: rgb(255 255 255 / 0.5);
    transition: text-decoration-color 0.2s ease;
  }

  .pricing__more a:hover {
    text-decoration-color: currentColor;
  }

  /* ---- Phones / tablet portrait ---- */
  @media (max-width: 820px) {
    .plans {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      gap: 16px;
      margin-top: 48px;
    }

    .plan {
      --radius: 22px;
      display: flex;
      flex-direction: column;
      grid-row: auto;
      padding: 28px 24px;
    }

    .plan--pro {
      box-shadow: 0 0 48px rgb(255 90 30 / 0.1);
    }

    .plan__name {
      margin-top: 6px;
      font-size: 26px;
    }

    .plan__price {
      min-height: 0;
      margin-top: 14px;
      font-size: 44px;
    }

    .plan__price--muted {
      padding-bottom: 0;
      font-size: 22px;
    }

    .plan__features {
      gap: 10px;
      margin-top: 20px;
      padding-top: 20px;
    }

    .plan__features li {
      gap: 10px;
    }

    .plan__foot {
      padding-top: 28px;
    }

    /* Full-width buttons, easy to tap. */
    .plan__foot > :global(a) {
      width: 100%;
      justify-content: center;
    }

    .plan__note {
      margin-top: 12px;
      text-align: center;
    }

    .pricing__faq {
      margin-top: 64px;
    }

    .pricing__more {
      margin-top: 28px;
    }
  }

  @media (forced-colors: active) {
    .plan--pro {
      border: 1px solid CanvasText;
      background: Canvas;
    }
  }
</style>
