---
/**
 * Not-found page. Astro emits it as dist/404.html, which GitHub Pages serves
 * for any missing path, at any depth (/a/b/c): every URL on it is absolute
 * and carries the deploy base (Astro's bundles, withBase() for links and
 * public files), never relative.
 *
 * One screen: the site header (H menu), a giant "404" in the HAPTIC title's
 * chromatic recipe (shared ChromaticTitle) over a dimmed copy of the hero's
 * glow on the page black, a line of copy and one button back home. All drawn
 * in code: no images. The load-in mirrors the hero's (fringes converge, copy
 * rises); the global reduced-motion rule turns it into a plain appearance.
 *
 * Sizes are mockup pixels (calc(N * var(--u))) on desktop; ≤ 820px switches to
 * phone sizes. --fs, the size of the "404", also scales the glow behind it.
 */
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Grain from '../components/Grain.astro';
import ChromaticTitle from '../components/ChromaticTitle.astro';
import FringeButton from '../components/FringeButton.astro';
import { glowBackground, GLOW_WIDTH, GLOW_HEIGHT } from '../components/hero/glow';
import { withBase } from '../lib/paths';

const glow = glowBackground();
---

<Base title="Page not found — Haptic" description="This page doesn’t exist." noindex>
  <SiteHeader />

  <main id="main" class="nf">
    <div class="nf__content">
      <div class="nf__glow" aria-hidden="true" style={`--glow: ${glow}; --glow-ratio: ${GLOW_HEIGHT / GLOW_WIDTH}`}></div>

      <h1 class="nf__heading">
        <ChromaticTitle text="404" class="nf__code" />{' '}
        <span class="visually-hidden">Page not found</span>
      </h1>

      <p class="nf__line">This page doesn’t exist.</p>

      <FringeButton class="nf__home" href={withBase('/')}>
        <svg class="nf__home-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
          <path d="M13.25 8H2.75M7.25 3.5 2.75 8l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span>Back to home</span>
      </FringeButton>
    </div>

    <Grain />
  </main>
</Base>

<style>
  .nf {
    /* Size of the "404"; the glow and the spacing follow it. */
    --fs: min(calc(300 * var(--u)), 38vh);
    --safe-top: env(safe-area-inset-top, 0px);
    position: relative;
    isolation: isolate;
    overflow: clip;
    display: grid;
    place-items: center;
    min-height: 100vh;
    min-height: 100svh;
    /* Clear the fixed header; the extra space below lifts the block a little above centre
       (the digits' line box also has more room under the glyphs than above them). */
    padding: calc(var(--safe-top) + max(64px, 72 * var(--u))) var(--gutter) max(104px, calc(128 * var(--u)));
    color: var(--c-text);
    background: var(--c-bg);
  }

  /* No z-index here: the text sits under the grain like the hero's, the button above it. */
  .nf__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .nf__heading {
    position: relative;
    z-index: var(--z-content);
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
  }

  /* The hero's glow, dimmed to a hint and scaled with the "404" (1280u wide at the
     desktop size, as in the hero, so one glow pixel is fs / 300). Its title band sits on
     the centre of the digits' line box, the first fs of the column: y 325 of the glow =
     the desktop hero's title centre, 239u + 172.5u / 2 (the phone hero aligns y 315
     instead, to fit its stretched glow between its title and the editor window). */
  .nf__glow {
    position: absolute;
    z-index: var(--z-bg);
    top: calc(var(--fs) / 2);
    left: 50%;
    width: calc(var(--fs) * 1280 / 300);
    height: calc(var(--fs) * 1280 / 300 * var(--glow-ratio));
    translate: -50% calc(var(--fs) * -325 / 300);
    background-image: var(--glow);
    opacity: 0.38;
    /* The magenta floor is wider than the box: feather the sides where it is cut. */
    mask-image: linear-gradient(to right, transparent, #000 14%, #000 86%, transparent);
    pointer-events: none;
    animation: nf-glow-in 1.8s var(--ease-out) both;
  }

  .nf__code {
    position: relative;
    display: block;
    --t: calc(var(--fs) / 172.5);
  }

  .nf__line {
    position: relative;
    z-index: var(--z-content);
    margin: calc(var(--fs) * -0.04) 0 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: max(22px, calc(32 * var(--u)));
    line-height: 1.2;
    text-wrap: balance;
    animation: nf-rise 0.9s var(--ease-out) 0.45s both;
  }

  /* ---- Back home: the site's white button (FringeButton), placed and brought in here ---- */
  .nf__home {
    margin-top: max(36px, calc(48 * var(--u)));
    animation: nf-rise 0.9s var(--ease-out) 0.6s both;
  }

  .nf__home-icon {
    width: 0.9em;
    height: 0.9em;
  }

  /* ---- Load-in (end state = natural state) ---- */
  @keyframes nf-rise {
    from {
      opacity: 0;
      transform: translateY(calc(12 * var(--u)));
    }
  }

  @keyframes nf-glow-in {
    from {
      opacity: 0;
    }
  }

  /* ---- Phones / tablet portrait ---- */
  @media (max-width: 820px) {
    .nf {
      --fs: min(46vw, 34vh, 300px);
      padding: calc(var(--safe-top) + 80px) var(--gutter) 112px;
    }

    .nf__line {
      font-size: clamp(22px, 5.6vw, 28px);
    }
  }

  /* Short landscape screens (phones on their side): keep it to one screen. */
  @media (max-height: 520px) {
    .nf {
      padding-block: calc(var(--safe-top) + 64px) 24px;
    }

    .nf__home {
      margin-top: 28px;
    }
  }

  @media (forced-colors: active) {
    .nf__glow {
      display: none;
    }
  }
</style>
