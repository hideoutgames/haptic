---
// Dev-only grain calibration swatches (deleted before release).
import Base from '../../layouts/Base.astro';
import Grain from '../../components/Grain.astro';
const sw = ['#010000', '#010e1a', '#032f54', '#043d6b', '#963f29', '#ff3e02', '#d9641e', '#b02f57', '#808080', '#ffffff'];
---

<Base title="lab: grain">
  <main style="position:relative; display:grid; grid-template-columns: repeat(5, 200px);">
    {sw.map((c) => <div style={`background:${c}; height:200px`} data-c={c}></div>)}
    <Grain />
  </main>
</Base>
