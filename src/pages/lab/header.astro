---
// Dev-only isolation page (deleted before release). Header over a stand-in backdrop
// (the real Hero is being built in parallel, so it is not imported here).
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Grain from '../../components/Grain.astro';
---

<Base title="lab: header">
  <SiteHeader />
  <main>
    <div style="position:relative; height: 220vh; background: radial-gradient(ellipse 40% 45% at 50% 30%, #d9641e 0%, #c8403e 40%, #9c30a2 65%, transparent 80%), #0b0a08;">
      <p style="position:absolute; top:150px; width:100%; text-align:center; font-family: var(--font-serif); font-size: 32px; margin:0;">Hideout Presents</p>
      <p style="position:absolute; top:240px; width:100%; text-align:center; font-family: var(--font-display); font-size: 172px; line-height:1; margin:0;">HAPTIC</p>
      <Grain />
    </div>
  </main>
</Base>
