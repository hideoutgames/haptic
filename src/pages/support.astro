---
/**
 * Support page: a short FAQ and the support email address, in the shell the
 * secondary pages share (layouts/Page.astro: header, heading over a dimmed
 * hero glow, a centred column, footer). The questions use the shared Faq
 * component; the email link is the site's fringed white button.
 *
 * The FAQ answers are placeholders until the product copy is final. Sizes are
 * mockup pixels (calc(N * var(--u))) on desktop; ≤ 820px switches to phone sizes.
 */
import Page from '../layouts/Page.astro';
import Faq, { type FaqItem } from '../components/Faq.astro';
import FringeButton from '../components/FringeButton.astro';
import { SUPPORT_EMAIL as EMAIL } from '../data/site';
import { withBase } from '../lib/paths';

/** Placeholder questions; answers may hold simple inline HTML (links). */
const FAQ: FaqItem[] = [
  {
    q: 'Is Haptic free?',
    a: `On desktop, yes: Haptic is free on Mac, Windows and Linux while you, or the company you work for, makes less than $50,000 a year in revenue. On iPhone, iPad and Android, or above that revenue, it needs a Haptic Pro subscription. See <a href="${withBase('/pricing')}">Pricing</a> for details.`,
  },
  {
    q: 'Which devices does Haptic run on?',
    a: 'Mac, Windows and Linux computers, and iPhone, iPad and Android phones and tablets.',
  },
  {
    q: 'Where can I find the documentation?',
    a: 'The documentation is on its way. Until it is online, email us and we will help you directly.',
  },
  {
    q: 'How do I report a bug or suggest a feature?',
    a: `Email us at <a href="mailto:${EMAIL}">${EMAIL}</a>. Tell us what happened, which device and version of Haptic you use, and add a screenshot if you can.`,
  },
];
---

<Page
  title="Support — Haptic"
  description="Answers to common questions about Haptic, and how to reach us."
  heading="Support"
  lead="Quick answers, and how to reach us."
>
  <Faq class="support__faq" title="Frequently asked questions" items={FAQ} />

  <section class="contact" aria-labelledby="contact-title">
    <h2 id="contact-title" class="contact__title">Still need help?</h2>
    <p class="contact__text">Email us and we will get back to you.</p>
    <FringeButton class="contact__button" href={`mailto:${EMAIL}`}>
      <svg class="contact__icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
        <rect x="1.75" y="3.25" width="12.5" height="9.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
        <path d="m2.5 4.5 5.5 4.25 5.5-4.25" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <span>{EMAIL}</span>
    </FringeButton>
  </section>
</Page>

<style>
  .support__faq {
    margin-top: calc(96 * var(--u));
  }

  /* ---- Contact ---- */
  .contact {
    margin-top: calc(96 * var(--u));
    text-align: center;
  }

  .contact__title {
    margin: 0;
    font-size: calc(40 * var(--u));
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .contact__text {
    margin: calc(12 * var(--u)) 0 0;
    font-size: max(16px, calc(18 * var(--u)));
    color: var(--c-text-muted);
  }

  .contact__button {
    margin-top: calc(32 * var(--u));
  }

  .contact__icon {
    width: 1em;
    height: 1em;
  }

  /* ---- Phones / tablet portrait ---- */
  @media (max-width: 820px) {
    .support__faq {
      margin-top: 56px;
    }

    .contact {
      margin-top: 64px;
    }

    .contact__title {
      font-size: clamp(28px, 7.6vw, 36px);
    }

    .contact__text {
      margin-top: 10px;
    }

    .contact__button {
      margin-top: 24px;
    }
  }
</style>
