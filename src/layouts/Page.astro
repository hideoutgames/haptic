---
/**
 * Shell of the site's secondary pages (support, pricing): the site header (H
 * menu), a heading block like the download section's (Onest Bold title, serif
 * lead) over a dimmed copy of the hero's glow, a centred column for the page's
 * content (the default slot) and the footer.
 *
 * `width` is the column's width in mockup pixels (--u) on desktop; at ≤ 820px
 * the column takes the full width between the gutters, since --u is far below
 * 1px there.
 */
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Grain from '../components/Grain.astro';
import { glowBackground, GLOW_WIDTH, GLOW_HEIGHT } from '../components/hero/glow';

interface Props {
  /** Document title. */
  title: string;
  description: string;
  heading: string;
  lead: string;
  /** Column width in mockup pixels. */
  width?: number;
}

const { title, description, heading, lead, width = 880 } = Astro.props;
const glow = glowBackground();
---

<Base {title} {description}>
  <SiteHeader />

  <main id="main" class="page" style={`--col: calc(${width} * var(--u))`}>
    <div class="page__glow" aria-hidden="true" style={`--glow: ${glow}; --glow-ratio: ${GLOW_HEIGHT / GLOW_WIDTH}`}></div>

    <div class="page__inner">
      <header class="intro">
        <h1 class="title">{heading}</h1>
        <p class="lead">{lead}</p>
      </header>

      <slot />
    </div>

    <Grain />
  </main>

  <SiteFooter />
</Base>

<style>
  .page {
    --safe-top: env(safe-area-inset-top, 0px);
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding: calc(var(--safe-top) + 176 * var(--u)) var(--gutter) calc(140 * var(--u));
    color: var(--c-text);
    background: var(--c-bg);
  }

  /* The hero's glow, dimmed to a hint behind the heading (one glow pixel = one --u, as in the hero). */
  .page__glow {
    position: absolute;
    z-index: var(--z-bg);
    top: calc(var(--safe-top) - 120 * var(--u));
    left: 50%;
    width: calc(1280 * var(--u));
    height: calc(1280 * var(--u) * var(--glow-ratio));
    translate: -50% 0;
    background-image: var(--glow);
    opacity: 0.3;
    mask-image:
      linear-gradient(to right, transparent, #000 14%, #000 86%, transparent),
      linear-gradient(#000 45%, transparent 85%);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
    pointer-events: none;
  }

  .page__inner {
    position: relative;
    z-index: var(--z-content);
    max-width: var(--col);
    margin: 0 auto;
  }

  /* ---- Heading: as the download section's (Onest Bold title, serif lead) ---- */
  .intro {
    text-align: center;
  }

  .title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: calc(72 * var(--u));
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.028em;
  }

  .lead {
    margin: calc(18 * var(--u)) 0 0;
    font-family: var(--font-serif);
    font-size: calc(32 * var(--u));
    font-weight: 400;
    line-height: 1.2;
    text-wrap: balance;
  }

  /* ---- Phones / tablet portrait ---- */
  @media (max-width: 820px) {
    .page {
      padding: calc(var(--safe-top) + 112px) var(--gutter) 88px;
    }

    /* --u is far below 1px here: the column takes the full width. */
    .page__inner {
      max-width: none;
    }

    .page__glow {
      top: calc(var(--safe-top) - 60px);
      width: 1280px;
      height: calc(1280px * var(--glow-ratio));
      opacity: 0.25;
    }

    .title {
      font-size: clamp(42px, 12.6vw, 68px);
    }

    .lead {
      margin-top: 12px;
      font-size: clamp(20px, 5.4vw, 28px);
    }
  }

  @media (forced-colors: active) {
    .page__glow {
      display: none;
    }
  }
</style>
