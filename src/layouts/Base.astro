---
import '@fontsource-variable/onest';
import 'lenis/dist/lenis.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Haptic — the portable game engine',
  description = 'Haptic by Hideout is a touch-first game engine you can bring anywhere: iPad, iPhone, Android, Mac, Windows and Linux.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0a08" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/licensed/block-berthold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/haptic-serif.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Procedural film grain, generated once per load (no image asset).
      // Each pixel gets one gaussian sample: positive values go into a white
      // "light" tile (added with plus-lighter), negative values into a black
      // "dark" tile (multiplied, at twice the strength). Together they behave
      // like zero-mean additive noise, so mid-tones keep their colour and
      // blacks are only lifted by clipping, as in the mockup's noise filter.
      (function () {
        try {
          var dpr = Math.min(window.devicePixelRatio || 1, 3);
          var n = 256;
          function tile() {
            var c = document.createElement('canvas');
            c.width = c.height = n;
            return c;
          }
          var lc = tile(), dc = tile();
          var lctx = lc.getContext('2d'), dctx = dc.getContext('2d');
          var li = lctx.createImageData(n, n), di = dctx.createImageData(n, n);
          var l = li.data, d = di.data;
          for (var i = 0; i < l.length; i += 4) {
            // Box-Muller gaussian
            var g = Math.sqrt(-2 * Math.log(1 - Math.random())) * Math.cos(6.283185307 * Math.random());
            l[i] = l[i + 1] = l[i + 2] = 255;
            if (g > 0) l[i + 3] = Math.min(255, g * 88);
            else d[i + 3] = Math.min(255, -g * 112);
          }
          lctx.putImageData(li, 0, 0);
          dctx.putImageData(di, 0, 0);
          var s = document.documentElement.style;
          s.setProperty('--grain-light', 'url(' + lc.toDataURL('image/png') + ')');
          s.setProperty('--grain-dark', 'url(' + dc.toDataURL('image/png') + ')');
          s.setProperty('--grain-size', n / dpr + 'px');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      import { initSmoothScroll } from '../scripts/motion';
      initSmoothScroll();
    </script>
  </body>
</html>
